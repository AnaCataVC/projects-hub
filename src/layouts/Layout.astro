---
import '../styles/global.css';
import LanguageToggle from '../components/LanguageToggle.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import PoppyBackground from '../components/PoppyBackground.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
	title: string;
	isProjectPage?: boolean;
}

const { title, isProjectPage = false } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Ana-Catalina | Projects Hub" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
		<title>{title}</title>
		<script is:inline>
			if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}

			window.updateToggleUI = function(activeBtn, inactiveBtn, indicatorEl, isRight) {
				if (indicatorEl) indicatorEl.style.transform = isRight ? 'translateX(100%)' : 'translateX(0)';
				if (activeBtn) {
					activeBtn.classList.remove('text-slate-500', 'dark:text-slate-400');
					activeBtn.classList.add('text-slate-800', 'dark:text-slate-200');
				}
				if (inactiveBtn) {
					inactiveBtn.classList.remove('text-slate-800', 'dark:text-slate-200');
					inactiveBtn.classList.add('text-slate-500', 'dark:text-slate-400');
				}
			};
		</script>
	</head>
	<body class:list={[
		"relative min-h-screen selection:bg-indigo-200 selection:text-indigo-900 dark:selection:bg-indigo-900 dark:selection:text-indigo-100",
		isProjectPage ? "block" : "flex flex-col"
	]}>
		<Analytics />
		<PoppyBackground />
		
		<!-- Top Bar Controls (Relative flow on mobile for project pages, absolute on desktop and index) -->
		<div class:list={[
			"w-full z-20 animate-fade-in transition-all duration-300",
			isProjectPage 
				? "flex justify-between items-center px-6 pt-6 pb-2 sm:p-0 relative sm:absolute" 
				: "absolute"
		]}>
			<!-- Discreet Logo in corner -->
			<header id="global-logo" class:list={[
				"z-10",
				isProjectPage 
					? "relative top-0 left-0 sm:absolute sm:top-8 sm:left-8 lg:sm:top-12 lg:sm:left-12" 
					: "absolute top-8 left-8 sm:top-12 sm:left-12"
			]}>
				<a href="https://ana-catalina.com">
					<img src="/favicon.svg" alt="ACVC Logo" class="w-8 h-8 sm:w-10 sm:h-10 opacity-70 hover:opacity-100 transition-opacity duration-300" />
				</a>
			</header>

			<!-- Top Right Actions -->
			<div id="global-actions" class:list={[
				"flex gap-4",
				isProjectPage 
					? "relative top-0 right-0 sm:absolute sm:top-8 sm:right-8 lg:sm:top-12 lg:sm:right-12" 
					: "absolute top-8 right-8 sm:top-12 sm:right-12"
			]}>
				<LanguageToggle />
			</div>
		</div>
		<div class="hidden">
			<ThemeToggle />
		</div>

		<main id="main-content" class:list={[
			"px-4 sm:px-12 w-full max-w-5xl mx-auto pt-8 sm:pt-12 transition-all duration-300",
			isProjectPage ? "block pb-24 sm:pb-36 mt-4 sm:mt-0" : "flex-grow flex flex-col pb-8 sm:pb-12 mt-16 sm:mt-0"
		]}>
			<slot />
		</main>

		<div id="global-footer" class="flex w-full mt-auto animate-fade-in delay-300 justify-center px-6 sm:px-0">
			<footer class="w-full max-w-2xl border-t border-slate-200/50 dark:border-slate-800/50 pt-8 pb-4">
				<div class="flex flex-col sm:flex-row justify-center sm:justify-end items-center sm:items-start gap-8">
					<div class="flex flex-col items-center sm:items-end gap-3">
						<div class="flex gap-6">
							<a href="https://linkedin.com/in/ana-catalina/" aria-label="Perfil de LinkedIn de Ana-Catalina" target="_blank" rel="noopener noreferrer" class="text-slate-400 dark:text-slate-500 hover:text-indigo-500 dark:hover:text-indigo-400 transition-all duration-300 transform hover:scale-105">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
							</a>
							<a href="https://github.com/AnaCataVC/" aria-label="Perfil de GitHub de Ana-Catalina" target="_blank" rel="noopener noreferrer" class="text-slate-400 dark:text-slate-500 hover:text-indigo-500 dark:hover:text-indigo-400 transition-all duration-300 transform hover:scale-105">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
							</a>
						</div>
						<p class="text-xs font-light text-slate-400 dark:text-slate-500">
							&copy; {new Date().getFullYear()} Ana-Catalina.
						</p>
					</div>
				</div>
			</footer>
		</div>
	</body>
</html>
