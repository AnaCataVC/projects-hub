---
import '../styles/global.css';
import LanguageToggle from '../components/LanguageToggle.astro';
import PoppyBackground from '../components/PoppyBackground.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
	title: string;
	isProjectPage?: boolean;
	description?: string;
	lang?: string;
	image?: string;
	ogType?: string;
	canonicalURL?: string;
}

const {
	title,
	isProjectPage = false,
	description = "Ana-Catalina's central portfolio and applications directory. Featuring AI-assisted workflows, software engineering projects, and modern interactive web design.",
	lang = 'es',
	image = '/og-image.png',
	ogType = 'website',
	canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://projects.ana-catalina.com').href,
} = Astro.props;

const siteBase = Astro.site || 'https://projects.ana-catalina.com';
const cleanPath = Astro.url.pathname.replace(/^\/en(\/|$)/, '/');
const esHref = new URL(cleanPath, siteBase).href;
const enHref = new URL(cleanPath === '/' ? '/' : `/en${cleanPath}`, siteBase).href;

// Ensure absolute URL for social image previews (Open Graph & Twitter Cards)
const absoluteImageURL = new URL(image, siteBase).href;

// Schema.org structured data for WebSite and Person profile
const schemaOrgJSONLD = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": "Ana-Catalina Projects Hub",
	"url": Astro.site ? Astro.site.toString() : 'https://projects.ana-catalina.com',
	"author": {
		"@type": "Person",
		"name": "Ana-Catalina",
		"url": "https://ana-catalina.com",
		"sameAs": [
			"https://linkedin.com/in/ana-catalina/",
			"https://github.com/AnaCataVC/"
		]
	},
	"description": description
});
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Ana-Catalina" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="es" href={esHref} />
		<link rel="alternate" hreflang="en" href={enHref} />
		<link rel="alternate" hreflang="x-default" href={esHref} />

		<!-- Favicon and Fonts -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261026" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=20261026" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=20261026" />
		<link rel="icon" href="/favicon.ico?v=20261026" sizes="any" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20261026" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

		<!-- Open Graph / Facebook / LinkedIn -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={absoluteImageURL} />
		<meta property="og:site_name" content="Ana-Catalina | Projects Hub" />
		<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={absoluteImageURL} />

		<!-- Schema.org JSON-LD -->
		<script type="application/ld+json" set:html={schemaOrgJSONLD}></script>
		<script is:inline>
			if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}

			window.setThemeGlobal = function(isDark, saveToStorage = true) {
				if (isDark) {
					document.documentElement.classList.add('dark');
					if (saveToStorage) localStorage.setItem('theme', 'dark');
				} else {
					document.documentElement.classList.remove('dark');
					if (saveToStorage) localStorage.setItem('theme', 'light');
				}
			};

			window.updateToggleUI = function(activeBtn, inactiveBtn, indicatorEl, isRight) {
				if (indicatorEl) indicatorEl.style.transform = isRight ? 'translateX(100%)' : 'translateX(0)';
				if (activeBtn) {
					activeBtn.classList.remove('text-slate-500', 'dark:text-slate-400');
					activeBtn.classList.add('text-slate-800', 'dark:text-slate-200');
				}
				if (inactiveBtn) {
					inactiveBtn.classList.remove('text-slate-800', 'dark:text-slate-200');
					inactiveBtn.classList.add('text-slate-500', 'dark:text-slate-400');
				}
			};
		</script>
	</head>
	<body class:list={[
		"relative min-h-screen selection:bg-purple-200 selection:text-purple-900 dark:selection:bg-purple-950 dark:selection:text-purple-200",
		isProjectPage ? "block" : "flex flex-col"
	]}>
		<Analytics />
		<PoppyBackground />
		
		<!-- Top Bar Controls (Relative flow on mobile for project pages, absolute on desktop and index) -->
		<div id="global-top-bar" class:list={[
			"w-full z-20 animate-fade-in transition-all duration-300 pointer-events-none",
			isProjectPage 
				? "relative sm:absolute top-0 left-0" 
				: "absolute top-0 left-0"
		]}>
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex items-center justify-between h-16 pointer-events-auto">
					<!-- Discreet Logo in corner -->
					<header id="global-logo" class="z-10">
						<a href="https://ana-catalina.com" aria-label="Ana-Catalina Home" class="inline-flex items-center">
							<img src="/logo-ac.png" alt="Ana-Catalina AC Logo" class="w-8 h-8 rounded-lg object-contain opacity-90 hover:opacity-100 transition-opacity duration-300 drop-shadow-[0_2px_8px_rgba(46,230,229,0.25)]" />
						</a>
					</header>

					<!-- Top Right Actions -->
					<div id="global-actions" class="flex items-center gap-2.5 sm:gap-3">
						<LanguageToggle />
						<button
							id="global-theme-toggle"
							type="button"
							aria-label={lang === 'en' ? 'Toggle theme' : 'Cambiar tema'}
							title={lang === 'en' ? 'Toggle theme' : 'Cambiar tema'}
							onclick="if(window.setThemeGlobal) { const isDark = document.documentElement.classList.contains('dark'); window.setThemeGlobal(!isDark); localStorage.setItem('terminalThemeSet', 'true'); }"
							class="w-9 h-9 rounded-full flex items-center justify-center bg-white/60 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60 backdrop-blur-sm text-slate-600 dark:text-slate-300 hover:text-brand-purple dark:hover:text-brand-purple-light hover:border-brand-purple/40 dark:hover:border-brand-purple/40 shadow-sm transition-all cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple"
						>
							<svg class="block dark:hidden pointer-events-none w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
							<svg class="hidden dark:block pointer-events-none w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
						</button>
					</div>
				</div>
			</div>
		</div>

		<main id="main-content" class:list={[
			"px-3 sm:px-8 lg:px-12 w-full max-w-5xl mx-auto transition-all duration-300",
			isProjectPage ? "block pt-1 sm:pt-14 pb-20 sm:pb-32 mt-0" : "flex-grow flex flex-col pt-8 sm:pt-12 pb-8 sm:pb-12 mt-16 sm:mt-0"
		]}>
			<slot />
		</main>

		<div id="global-footer" class="flex w-full mt-auto animate-fade-in delay-300 justify-center px-6 sm:px-0">
			<footer class="w-full max-w-2xl border-t border-slate-200/50 dark:border-slate-800/50 pt-8 pb-4">
				<div class="flex flex-col sm:flex-row justify-center sm:justify-end items-center sm:items-start gap-8">
					<div class="flex flex-col items-center sm:items-end gap-3">
						<div class="flex gap-6">
							<a href="https://linkedin.com/in/ana-catalina/" aria-label="Perfil de LinkedIn de Ana-Catalina" target="_blank" rel="noopener noreferrer" class="text-slate-400 dark:text-slate-500 hover:text-brand-purple dark:hover:text-brand-purple-light transition-all duration-300 transform hover:scale-105">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
							</a>
							<a href="https://github.com/AnaCataVC/" aria-label="Perfil de GitHub de Ana-Catalina" target="_blank" rel="noopener noreferrer" class="text-slate-400 dark:text-slate-500 hover:text-brand-purple dark:hover:text-brand-purple-light transition-all duration-300 transform hover:scale-105">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
							</a>
						</div>
						<p class="text-xs font-light text-slate-400 dark:text-slate-500">
							&copy; {new Date().getFullYear()} Ana-Catalina.
						</p>
					</div>
				</div>
			</footer>
		</div>
	</body>
</html>
