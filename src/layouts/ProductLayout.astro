---
import '../styles/global.css';
import PoppyBackground from '../components/PoppyBackground.astro';
import Analytics from '@vercel/analytics/astro';
import * as lucide from 'lucide-static';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  lang: 'es' | 'en';
  slug: string;
}

const { entry, lang, slug } = Astro.props;
const { title, icon, githubUrl, websiteUrl } = entry.data;
const product = entry.data.product!;

// The page is served on the project's own subdomain through a host rewrite, so canonical and
// language links point at that host; the ficha lives on projects-hub, hence absolute URLs.
const productHome = (websiteUrl ?? `https://${slug}.ana-catalina.com`).replace(/\/?$/, '/');
const productHost = new URL(productHome).hostname;
const canonicalURL = lang === 'en' ? `${productHome}en` : productHome;
const fichaURL = `https://projects.ana-catalina.com/${lang === 'en' ? 'en/' : ''}${slug}`;
const absoluteIcon = icon ? new URL(icon, 'https://projects.ana-catalina.com').href : undefined;
const iconType = icon?.endsWith('.svg')
  ? 'image/svg+xml'
  : icon?.endsWith('.png')
    ? 'image/png'
    : icon?.endsWith('.ico')
      ? 'image/x-icon'
      : 'image/png';

const t = {
  es: {
    features: 'Qué hace',
    screenshots: 'Así se ve',
    faq: 'Preguntas frecuentes',
    details: 'Ficha técnica',
    source: 'Código en GitHub',
    download: 'Descargar',
    platforms: 'Disponible para',
    theme: 'Cambiar tema',
    copy: 'Copiar',
    copied: '¡Copiado!',
    terminalTitle: 'Consola de Inicio',
    architectureTitle: '¿Te interesa cómo está construido?',
    architectureText: 'Explora las decisiones de arquitectura, stack tecnológico y aprendizajes clave en la ficha técnica completa de Projects Hub.',
    trustPrivate: 'Local-First y Privado',
    trustPrivateDesc: 'Cero telemetría externa. Tus datos se quedan en tu dispositivo.',
    trustPerf: 'Arquitectura Nativa',
    trustPerfDesc: 'Construcción optimizada, sin sobrecarga ni bloqueos.',
    trustOpen: 'Auditable y Abierto',
    trustOpenDesc: 'Código fuente abierto y transparente en GitHub.',
    close: 'Cerrar',
  },
  en: {
    features: 'What it does',
    screenshots: 'How it looks',
    faq: 'FAQ',
    details: 'Tech specs',
    source: 'GitHub repo',
    download: 'Download',
    platforms: 'Available for',
    theme: 'Toggle theme',
    copy: 'Copy',
    copied: 'Copied!',
    terminalTitle: 'Quick Start Console',
    architectureTitle: 'Curious about how it was built?',
    architectureText: 'Explore architectural trade-offs, technology stack, and key engineering learnings in the full Projects Hub case study.',
    trustPrivate: 'Local-First & Private',
    trustPrivateDesc: 'Zero telemetry. Your data stays on your device.',
    trustPerf: 'Native Architecture',
    trustPerfDesc: 'Optimized build, zero bloatware or lag.',
    trustOpen: 'Auditable & Open Source',
    trustOpenDesc: 'Transparent open source code on GitHub.',
    close: 'Close',
  },
}[lang];

function iconSvg(name: string): string {
  const svg = (lucide as Record<string, unknown>)[name];
  if (typeof svg !== 'string') throw new Error(`Unknown lucide icon "${name}" in ${entry.id}`);
  return svg;
}

const githubSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>`;

function getLinkIcon(url: string, label: string): string {
  const lowerUrl = url.toLowerCase();
  const lowerLabel = label.toLowerCase();
  if (lowerUrl.includes('catalog') || lowerLabel.includes('catalog') || lowerLabel.includes('herramienta') || lowerLabel.includes('tool')) {
    return 'Boxes';
  }
  if (lowerUrl.includes('quick-start') || lowerUrl.includes('start') || lowerLabel.includes('inicio') || lowerLabel.includes('start') || lowerLabel.includes('consola') || lowerLabel.includes('terminal')) {
    return 'Terminal';
  }
  if (lowerUrl.startsWith('#') || lowerUrl.startsWith('/')) {
    return 'ArrowRight';
  }
  return 'ExternalLink';
}

function renderLinkIcon(url: string, label: string): string {
  if (url.toLowerCase().includes('github.com') || label.toLowerCase().includes('github')) {
    return githubSvg;
  }
  return iconSvg(getLinkIcon(url, label));
}

const customLinks = product.links.filter((link) => !link.url.includes('github.com') && link.url !== githubUrl);

// -----------------------------------------------------------------------------
// Unified Signature Aura (Pastel-Tech: Electric Violet & Crystal Aqua)
// Solid buttons, solid text, zero gradients on text or buttons.
// -----------------------------------------------------------------------------
const aura = {
  glowOrb1: 'from-brand-violet/20 via-brand-aqua/15 to-pastel-lilac/15',
  glowOrb2: 'from-brand-aqua/20 via-brand-violet/15 to-pastel-blue/15',
  badgeBg: 'bg-brand-purple/10 dark:bg-brand-purple/15 border-brand-purple/25 text-brand-purple dark:text-brand-purple-light',
  badgeDot: 'bg-brand-aqua',
  primaryBtn: 'bg-brand-purple hover:bg-brand-violet-deep text-white shadow-md shadow-brand-purple/20 hover:shadow-lg hover:shadow-brand-purple/35 hover:-translate-y-0.5',
  cardBorderHover: 'hover:border-brand-purple/40 hover:shadow-brand-purple/10',
  iconBox: 'bg-brand-purple/10 text-brand-purple dark:text-brand-purple-light border border-brand-purple/20',
  tagBg: 'bg-brand-purple/10 text-brand-purple dark:text-brand-purple-light border-brand-purple/20',
  terminalAccent: 'text-brand-aqua dark:text-brand-aqua-light',
};

const jsonLD = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: title,
  description: product.intro,
  url: canonicalURL,
  operatingSystem: product.platforms.join(', ') || undefined,
  applicationCategory: 'UtilitiesApplication',
  author: { '@type': 'Person', name: 'Ana-Catalina', url: 'https://ana-catalina.com' },
});

// Solid buttons (Strictly NO gradients)
const primaryBtnClass = `inline-flex items-center justify-center gap-2 px-6 py-2.5 sm:px-7 sm:py-3 rounded-xl ${aura.primaryBtn} transition-all duration-200 active:scale-95 font-semibold text-sm sm:text-base tracking-wide text-white cursor-pointer select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-950`;
const secondaryBtnClass = 'inline-flex items-center justify-center gap-2 px-5 py-2.5 sm:px-6 sm:py-3 rounded-xl bg-white/80 dark:bg-slate-900/80 border border-slate-200/90 dark:border-white/10 text-slate-700 dark:text-slate-200 hover:text-brand-purple dark:hover:text-brand-purple-light hover:bg-white dark:hover:bg-slate-800 hover:border-brand-purple/40 dark:hover:border-brand-purple/40 shadow-sm hover:shadow transition-all duration-200 active:scale-95 font-medium text-sm sm:text-base tracking-wide cursor-pointer select-none backdrop-blur-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-950';
const cardClass = `group relative rounded-2xl bg-white/70 dark:bg-slate-900/50 backdrop-blur-md border border-slate-200/70 dark:border-white/10 p-6 sm:p-8 shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 ${aura.cardBorderHover}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{`${title} — ${product.tagline}`}</title>
    <meta name="description" content={product.intro} />
    <meta name="author" content="Ana-Catalina" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={productHome} />
    <link rel="alternate" hreflang="en" href={`${productHome}en`} />
    <!-- Favicons: Project-specific icon takes full precedence over brand icon -->
    {icon ? (
      <>
        <link rel="icon" type={iconType} href={icon} />
        <link rel="shortcut icon" href={icon} />
        <link rel="apple-touch-icon" href={icon} />
      </>
    ) : (
      <>
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} — ${product.tagline}`} />
    <meta property="og:description" content={product.intro} />
    {absoluteIcon && <meta property="og:image" content={absoluteIcon} />}
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <script is:inline type="application/ld+json" set:html={jsonLD}></script>
    <script is:inline>
      if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="relative min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 antialiased font-sans overflow-x-hidden selection:bg-brand-purple/20 selection:text-brand-purple dark:selection:text-brand-purple-light">
    <Analytics />

    <!-- Ambient Glowing Light Orbs (Pastel-Tech Depth & Energy) -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
      <div class:list={['absolute top-[-15%] left-[-10%] w-[55vw] h-[55vw] max-w-[650px] max-h-[650px] rounded-full blur-[130px] opacity-45 dark:opacity-25 bg-gradient-to-br mix-blend-multiply dark:mix-blend-screen transition-opacity duration-500', aura.glowOrb1]}></div>
      <div class:list={['absolute bottom-[-10%] right-[-10%] w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] rounded-full blur-[140px] opacity-45 dark:opacity-25 bg-gradient-to-br mix-blend-multiply dark:mix-blend-screen transition-opacity duration-500', aura.glowOrb2]}></div>
    </div>

    <!-- Ana-Catalina Signature Poppy Watermark (Subtle Brand Identity) -->
    <PoppyBackground />

    <!-- Top Navigation Header (Ecosystem standard: h-16, max-w-6xl mx-auto px-4 sm:px-6 lg:px-8) -->
    <header class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between z-20">
      <div class="flex items-center gap-2.5 sm:gap-3">
        <!-- Monogram AC (Ecosystem Brand Anchor) -->
        <a href="https://ana-catalina.com" class="group flex items-center shrink-0" aria-label="Ana-Catalina Home">
          <img src="/logo-ac.png" alt="Ana-Catalina AC Logo" class="w-8 h-8 rounded-lg object-contain opacity-90 group-hover:opacity-100 transition-all duration-300 drop-shadow-[0_2px_8px_rgba(46,230,229,0.3)] group-hover:scale-105" />
        </a>
        <span class="text-slate-300 dark:text-slate-700 font-light select-none text-sm">/</span>
        <!-- Project Title Anchor -->
        <a href="#top" class="flex items-center gap-2 sm:gap-2.5 font-semibold group transition-transform active:scale-95 min-w-0">
          {icon ? (
            <img src={icon} alt="" class="w-7 h-7 rounded-lg object-contain drop-shadow-sm group-hover:scale-105 transition-transform shrink-0" />
          ) : (
            <div class:list={['w-7 h-7 rounded-lg flex items-center justify-center font-bold text-xs shrink-0', aura.iconBox]}>
              {title.slice(0, 2).toUpperCase()}
            </div>
          )}
          <span class="tracking-tight text-base sm:text-lg text-slate-900 dark:text-white font-[Outfit] truncate">{title}</span>
        </a>
      </div>

      <!-- Controls: Language Toggle Pill & Dark Mode Toggle -->
      <div class="flex items-center gap-2.5 sm:gap-3">
        <div class="flex items-center bg-white/80 dark:bg-slate-900/70 rounded-full p-1 border border-slate-200/80 dark:border-white/10 shadow-sm backdrop-blur-md relative">
          <div
            id="lang-indicator"
            class="absolute top-1 bottom-1 left-1 bg-brand-purple/15 dark:bg-white/15 rounded-full transition-transform duration-300 ease-out w-[calc(50%-4px)] pointer-events-none"
            style={lang === 'en' ? 'transform: translateX(100%)' : 'transform: translateX(0)'}
          ></div>
          <a
            data-lang-link="es"
            href="/"
            class:list={[
              'relative z-10 w-10 sm:w-11 h-7 rounded-full text-xs font-semibold transition-colors flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple',
              lang === 'es' ? 'text-brand-purple dark:text-brand-purple-light' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white',
            ]}
          >
            ES
          </a>
          <a
            data-lang-link="en"
            href="/en"
            class:list={[
              'relative z-10 w-10 sm:w-11 h-7 rounded-full text-xs font-semibold transition-colors flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple',
              lang === 'en' ? 'text-brand-purple dark:text-brand-purple-light' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white',
            ]}
          >
            EN
          </a>
        </div>

        <button
          id="theme-toggle"
          type="button"
          aria-label={t.theme}
          class="w-9 h-9 rounded-full flex items-center justify-center bg-white/80 dark:bg-slate-900/70 border border-slate-200/80 dark:border-white/10 backdrop-blur-md text-slate-600 dark:text-slate-300 hover:text-brand-purple dark:hover:text-white hover:border-brand-purple/40 dark:hover:border-white/30 shadow-sm transition-all [&>svg]:w-4 [&>svg]:h-4 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-950"
          set:html={iconSvg('SunMoon')}
        ></button>
      </div>
    </header>

    <main id="top" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
      <!-- Hero Section -->
      <section class="text-center pt-8 sm:pt-12 pb-12 animate-fade-in flex flex-col items-center">
        <!-- Project Hero Logo with Subtle Glass Pedestal -->
        {icon && (
          <div class="mb-6 flex justify-center group">
            <div class="p-1.5 rounded-[28px] bg-white/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-white/10 shadow-xl backdrop-blur-md transition-transform duration-300 group-hover:scale-105">
              <img
                src={icon}
                alt={title}
                class="w-20 h-20 sm:w-24 sm:h-24 object-contain rounded-[22px] drop-shadow-[0_8px_20px_rgba(0,0,0,0.1)] dark:drop-shadow-[0_0_30px_rgba(185,141,253,0.3)]"
              />
            </div>
          </div>
        )}

        <!-- Kicker / Eyebrow Badge with Product Name and Platforms -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border mb-6 text-xs font-medium backdrop-blur-md shadow-sm bg-white/70 dark:bg-slate-900/60 border-slate-200/80 dark:border-white/10 text-slate-700 dark:text-slate-200">
          <span class="font-bold text-slate-900 dark:text-white font-[Outfit] tracking-wide">{title}</span>
          <span class="text-slate-300 dark:text-slate-700 select-none">|</span>
          <span class:list={['w-2 h-2 rounded-full animate-pulse', aura.badgeDot]}></span>
          <span class="text-slate-600 dark:text-slate-300">{product.platforms.length > 0 ? product.platforms.join(' · ') : (lang === 'es' ? 'Disponible Ahora' : 'Available Now')}</span>
        </div>

        <!-- Headline: Solid Typography (Zero Gradients) -->
        <h1 class="font-extrabold text-4xl sm:text-6xl md:text-7xl leading-[1.12] sm:leading-[1.14] tracking-tight max-w-4xl font-[Outfit] text-purple-950 dark:text-brand-purple-light">
          {product.tagline}
        </h1>

        <!-- Subtitle / Intro -->
        <p class="mt-6 max-w-2xl mx-auto text-base sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-[Inter]">
          {product.intro}
        </p>

        <!-- Hero CTAs (Solid Buttons, Zero Gradients) -->
        <div class="mt-8 flex flex-wrap gap-3 sm:gap-3.5 justify-center items-center max-w-2xl mx-auto">
          {product.downloadUrl && (
            <a href={product.downloadUrl} target="_blank" rel="noopener noreferrer" class={primaryBtnClass}>
              <span class="[&>svg]:w-4.5 [&>svg]:h-4.5 shrink-0" set:html={iconSvg('Download')}></span>
              <span>{product.downloadLabel ?? t.download}</span>
            </a>
          )}
          {customLinks.map((link) => (
            <a href={link.url} target={link.url.startsWith('#') ? undefined : '_blank'} rel="noopener noreferrer" class={secondaryBtnClass}>
              <span class="[&>svg]:w-4.5 [&>svg]:h-4.5 shrink-0 opacity-80" set:html={renderLinkIcon(link.url, link.label)}></span>
              <span>{link.label}</span>
            </a>
          ))}
          <a href={fichaURL} class={secondaryBtnClass}>
            <span class="[&>svg]:w-4.5 [&>svg]:h-4.5 shrink-0 opacity-80" set:html={iconSvg('FileText')}></span>
            <span>{t.details}</span>
          </a>
          {githubUrl && (
            <a href={githubUrl} target="_blank" rel="noopener noreferrer" class={secondaryBtnClass}>
              <span class="[&>svg]:w-4.5 [&>svg]:h-4.5 shrink-0 opacity-80" set:html={githubSvg}></span>
              <span>{t.source}</span>
            </a>
          )}
        </div>

        <!-- Hero Window Mockup Showcase (If primary screenshot exists) -->
        {product.screenshots.length > 0 && (
          <div class="mt-12 sm:mt-16 w-full max-w-4xl mx-auto group">
            <div class="relative rounded-2xl bg-white/80 dark:bg-slate-900/80 border border-slate-200/90 dark:border-white/10 shadow-2xl shadow-brand-purple/10 dark:shadow-black/70 overflow-hidden backdrop-blur-xl transition-all duration-300 hover:border-brand-purple/40">
              <!-- Window Title Bar -->
              <div class="flex items-center justify-between px-4 py-3 bg-slate-100/90 dark:bg-slate-950/70 border-b border-slate-200/80 dark:border-white/10 select-none">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-full bg-rose-400/80 border border-rose-500/30"></span>
                  <span class="w-3 h-3 rounded-full bg-amber-400/80 border border-amber-500/30"></span>
                  <span class="w-3 h-3 rounded-full bg-emerald-400/80 border border-emerald-500/30"></span>
                </div>
                <span class="text-xs font-mono text-slate-500 dark:text-slate-400 truncate max-w-[200px] sm:max-w-none">{title}</span>
                <div class="flex items-center gap-1 text-xs text-slate-400 font-mono">
                  <span class="[&>svg]:w-3.5 [&>svg]:h-3.5" aria-hidden="true" set:html={iconSvg('ZoomIn')}></span>
                </div>
              </div>
              <!-- Primary Screenshot Preview -->
              <div
                class="p-2 sm:p-4 bg-slate-950/5 dark:bg-black/40 cursor-pointer group/preview relative overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple rounded-xl"
                role="button"
                tabindex="0"
                data-lightbox-trigger={product.screenshots[0].src}
                data-lightbox-alt={product.screenshots[0].alt}
                aria-label={lang === 'es' ? `Ampliar captura de ${title}` : `Zoom screenshot of ${title}`}
                title={lang === 'es' ? 'Haz clic o presiona Enter para ampliar captura' : 'Click or press Enter to zoom screenshot'}
              >
                <img
                  src={product.screenshots[0].src}
                  alt={product.screenshots[0].alt}
                  class="w-full h-auto max-h-[500px] object-contain rounded-xl mx-auto shadow-sm transition-transform duration-300 group-hover/preview:scale-[1.005]"
                  loading="eager"
                />
              </div>
            </div>
          </div>
        )}
      </section>

      <!-- Engineering Trust Badges / Pillars -->
      <section class="py-6 sm:py-8 border-y border-slate-200/70 dark:border-white/10 my-8">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center sm:text-left">
          <div class="flex items-center gap-3.5 justify-center sm:justify-start">
            <span class="w-10 h-10 rounded-xl bg-brand-aqua/10 text-brand-aqua-deep dark:text-brand-aqua flex items-center justify-center shrink-0 border border-brand-aqua/20" set:html={iconSvg('ShieldCheck')}></span>
            <div>
              <h4 class="font-[Outfit] font-semibold text-slate-900 dark:text-white text-sm">{t.trustPrivate}</h4>
              <p class="text-xs text-slate-500 dark:text-slate-400 font-[Inter] leading-relaxed">{t.trustPrivateDesc}</p>
            </div>
          </div>
          <div class="flex items-center gap-3.5 justify-center sm:justify-start">
            <span class="w-10 h-10 rounded-xl bg-brand-purple/10 text-brand-purple dark:text-brand-purple-light flex items-center justify-center shrink-0 border border-brand-purple/20" set:html={iconSvg('Zap')}></span>
            <div>
              <h4 class="font-[Outfit] font-semibold text-slate-900 dark:text-white text-sm">{t.trustPerf}</h4>
              <p class="text-xs text-slate-500 dark:text-slate-400 font-[Inter] leading-relaxed">{t.trustPerfDesc}</p>
            </div>
          </div>
          <div class="flex items-center gap-3.5 justify-center sm:justify-start">
            <span class="w-10 h-10 rounded-xl bg-pastel-lilac/20 text-brand-violet-deep dark:text-pastel-lilac flex items-center justify-center shrink-0 border border-pastel-lilac/30" set:html={iconSvg('Code2')}></span>
            <div>
              <h4 class="font-[Outfit] font-semibold text-slate-900 dark:text-white text-sm">{t.trustOpen}</h4>
              <p class="text-xs text-slate-500 dark:text-slate-400 font-[Inter] leading-relaxed">{t.trustOpenDesc}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Features Grid (Centered Flex Bento) -->
      <section class="py-14" aria-labelledby="features-title">
        <div class="text-center mb-12">
          <h2 id="features-title" class="font-bold text-3xl sm:text-4xl text-slate-900 dark:text-white font-[Outfit] tracking-tight">
            {t.features}
          </h2>
        </div>
        <div class="flex flex-wrap justify-center gap-6">
          {product.features.map((feature) => (
            <article class:list={[cardClass, 'w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)] flex flex-col']}>
              <span class:list={['inline-flex w-12 h-12 items-center justify-center rounded-xl backdrop-blur-sm transition-transform duration-300 group-hover:scale-110 mb-5 [&>svg]:w-6 [&>svg]:h-6 shadow-sm', aura.iconBox]} set:html={iconSvg(feature.icon)}></span>
              <h3 class="font-semibold text-xl text-slate-900 dark:text-white font-[Outfit] tracking-tight">{feature.title}</h3>
              <p class="mt-2.5 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed font-[Inter]">{feature.text}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Catalog / Utility Groups Section (Centered Flex Bento) -->
      {product.catalog && (
        <section id="catalog" class="py-14 scroll-mt-24" aria-labelledby="catalog-title">
          <div class="text-center mb-12">
            <h2 id="catalog-title" class="font-bold text-3xl sm:text-4xl text-slate-900 dark:text-white font-[Outfit] tracking-tight">
              {product.catalog.title}
            </h2>
          </div>
          <div class="flex flex-wrap justify-center gap-6">
            {product.catalog.items.map((item) => (
              <article class="w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)] rounded-2xl bg-white/70 dark:bg-slate-900/50 backdrop-blur-md border border-slate-200/70 dark:border-white/10 flex flex-col hover:border-brand-purple/40 dark:hover:border-brand-purple/40 transition-all shadow-sm hover:shadow-lg overflow-hidden group">
                <div class="p-6 pb-4">
                  <h3 class="font-mono text-base font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-2">
                    <span class:list={['w-2 h-2 rounded-full', aura.badgeDot]}></span>
                    {item.title}
                  </h3>
                  <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed font-[Inter]">{item.description}</p>
                </div>
                {item.tags.length > 0 && (
                  <div class="bg-slate-100/60 dark:bg-black/30 p-4 mt-auto border-t border-slate-200/60 dark:border-white/5">
                    <div class="flex flex-wrap gap-1.5">
                      {item.tags.map((tag) => (
                        <span class:list={['px-2.5 py-0.5 rounded-md text-xs font-mono border backdrop-blur-sm', aura.tagBg]}>
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>
      )}

      <!-- DevTools / Quick Start Terminal (Minimalist Monochromatic Console) -->
      {product.codeSnippets.length > 0 && (
        <section id="quick-start" class="py-14 scroll-mt-24 max-w-3xl mx-auto" aria-labelledby="quickstart-title">
          <div class="text-center mb-8">
            <h2 id="quickstart-title" class="font-bold text-3xl text-slate-900 dark:text-white font-[Outfit] tracking-tight">
              {t.terminalTitle}
            </h2>
          </div>

          <div class="w-full rounded-2xl bg-slate-950 text-slate-200 border border-slate-800/80 shadow-2xl overflow-hidden font-mono backdrop-blur-xl">
            <!-- Terminal Window Header (Minimalist Monochromatic) -->
            <div class="flex items-center justify-between px-4 sm:px-5 py-3 bg-slate-900/80 border-b border-slate-800/80">
              <div class="flex items-center gap-2 text-xs text-slate-400 select-none font-mono">
                <span class="text-slate-500 font-bold">&gt;_</span>
                <span>terminal — {title}</span>
              </div>

              <!-- Interactive Tabs (When Multiple Snippets Exist) -->
              {product.codeSnippets.length > 1 && (
                <div class="flex items-center gap-1 bg-slate-950/70 p-1 rounded-lg border border-slate-850">
                  {product.codeSnippets.map((snippet, idx) => (
                    <button
                      type="button"
                      data-snippet-tab={idx}
                      class:list={[
                        'px-2.5 py-1 rounded text-xs transition-colors cursor-pointer',
                        idx === 0 ? 'bg-white/15 text-white font-medium shadow-sm' : 'text-slate-400 hover:text-slate-200',
                      ]}
                    >
                      {snippet.title}
                    </button>
                  ))}
                </div>
              )}
            </div>

            <!-- Snippets Content -->
            {product.codeSnippets.map((snippet, idx) => (
              <div data-snippet-content={idx} class:list={['p-5 sm:p-6 text-sm relative group', idx !== 0 && 'hidden']}>
                {product.codeSnippets.length === 1 && (
                  <div class="text-xs text-slate-400 mb-3 font-semibold uppercase tracking-wider">{snippet.title}</div>
                )}
                <div class="flex items-start justify-between gap-4">
                  <pre class="overflow-x-auto text-slate-100 flex-1 leading-relaxed"><code class={`language-${snippet.language}`}>{snippet.code.trim()}</code></pre>
                  <button
                    type="button"
                    data-copy-btn
                    data-copy-text={snippet.code.trim()}
                    aria-label={t.copy}
                    class="shrink-0 p-2 rounded-lg bg-white/10 hover:bg-white/20 text-slate-300 hover:text-white transition-all cursor-pointer flex items-center gap-1.5 text-xs font-sans border border-white/5"
                  >
                    <span class="copy-icon [&>svg]:w-4 [&>svg]:h-4" set:html={iconSvg('Copy')}></span>
                    <span class="copy-label hidden sm:inline">{t.copy}</span>
                  </button>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Notice Aside -->
      {product.notice && (
        <aside class:list={['my-12 rounded-2xl p-6 sm:p-8 border backdrop-blur-md shadow-sm', aura.badgeBg]}>
          <h2 class="font-semibold text-lg font-[Outfit] text-slate-900 dark:text-white flex items-center gap-2">
            <span class="[&>svg]:w-5 [&>svg]:h-5" set:html={iconSvg('Info')}></span>
            {product.notice.title}
          </h2>
          <p class="mt-2 text-sm sm:text-base leading-relaxed font-[Inter] opacity-90">{product.notice.text}</p>
        </aside>
      )}

      <!-- Screenshots Gallery with Lightbox support -->
      {product.screenshots.length > 0 && (
        <section class="py-14" aria-labelledby="screens-title">
          <div class="text-center mb-12">
            <h2 id="screens-title" class="font-bold text-3xl sm:text-4xl text-slate-900 dark:text-white font-[Outfit] tracking-tight">
              {t.screenshots}
            </h2>
          </div>
          <div class="flex flex-wrap gap-8 justify-center">
            {product.screenshots.map((shot) => (
              <div
                class="group relative rounded-2xl p-1.5 sm:p-2 bg-white/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-white/10 shadow-xl dark:shadow-2xl dark:shadow-black/60 transition-all duration-300 hover:scale-[1.015] hover:border-brand-purple/40 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple"
                role="button"
                tabindex="0"
                data-lightbox-trigger={shot.src}
                data-lightbox-alt={shot.alt}
                aria-label={lang === 'es' ? `Ampliar captura: ${shot.alt}` : `Zoom screenshot: ${shot.alt}`}
                title={lang === 'es' ? 'Haz clic o presiona Enter para ampliar captura' : 'Click or press Enter to zoom screenshot'}
              >
                <img
                  src={shot.src}
                  alt={shot.alt}
                  loading="lazy"
                  class="max-h-[560px] w-auto max-w-full rounded-xl object-contain block shadow-sm"
                />
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- FAQ Section -->
      {product.faq.length > 0 && (
        <section class="py-14 max-w-3xl mx-auto" aria-labelledby="faq-title">
          <div class="text-center mb-12">
            <h2 id="faq-title" class="font-bold text-3xl sm:text-4xl text-slate-900 dark:text-white font-[Outfit] tracking-tight">
              {t.faq}
            </h2>
          </div>
          <div class="space-y-4">
            {product.faq.map((item) => (
              <details class="group rounded-2xl bg-white/70 dark:bg-slate-900/50 backdrop-blur-md border border-slate-200/80 dark:border-white/10 px-6 py-4.5 shadow-sm hover:border-slate-300 dark:hover:border-white/25 transition-all">
                <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white list-none flex justify-between items-center gap-4 text-base sm:text-lg font-[Outfit]">
                  <span>{item.question}</span>
                  <span class:list={['text-lg font-bold group-open:rotate-45 transition-transform duration-200', aura.terminalAccent]}>+</span>
                </summary>
                <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-300 font-[Inter] leading-relaxed">{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- Behind the Architecture Bento Bridge -->
      <section class="py-10 border-t border-slate-200/70 dark:border-white/10 my-8">
        <div class="rounded-2xl p-6 sm:p-8 bg-white/70 dark:bg-slate-900/60 backdrop-blur-md border border-slate-200/80 dark:border-white/10 flex flex-col sm:flex-row items-center justify-between gap-6 hover:border-brand-purple/40 transition-all shadow-sm">
          <div class="space-y-2 text-center sm:text-left">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-mono font-medium bg-brand-aqua/10 text-brand-aqua-deep dark:text-brand-aqua border border-brand-aqua/20">
              <span class="[&>svg]:w-3.5 [&>svg]:h-3.5" set:html={iconSvg('Terminal')}></span>
              <span>{lang === 'es' ? 'Diseñado por Ana-Catalina' : 'Engineered by Ana-Catalina'}</span>
            </div>
            <h3 class="text-xl sm:text-2xl font-bold font-[Outfit] text-slate-900 dark:text-white">
              {t.architectureTitle}
            </h3>
            <p class="text-sm text-slate-600 dark:text-slate-300 font-[Inter] max-w-xl leading-relaxed">
              {t.architectureText}
            </p>
          </div>
          <a href={fichaURL} class={secondaryBtnClass}>
            <span class="[&>svg]:w-4 [&>svg]:h-4" set:html={iconSvg('FileText')}></span>
            <span>{t.details}</span>
            <span class="[&>svg]:w-4 [&>svg]:h-4" set:html={iconSvg('ArrowRight')}></span>
          </a>
        </div>
      </section>

      <!-- Bottom Download CTA -->
      {product.downloadUrl && (
        <section class="py-12 text-center">
          <a href={product.downloadUrl} target="_blank" rel="noopener noreferrer" class={primaryBtnClass}>
            <span class="[&>svg]:w-4.5 [&>svg]:h-4.5 shrink-0" set:html={iconSvg('Download')}></span>
            <span>{product.downloadLabel ?? t.download}</span>
          </a>
        </section>
      )}
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200/80 dark:border-white/10 py-10 text-center text-xs text-slate-500 dark:text-slate-400 font-[Inter] backdrop-blur-sm">
      <div class="flex justify-center flex-wrap gap-6 mb-4 font-medium">
        <a href={fichaURL} class="hover:text-brand-purple dark:hover:text-brand-purple-light transition-colors">{t.details}</a>
        {githubUrl && (
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-brand-purple dark:hover:text-brand-purple-light transition-colors">
            {t.source}
          </a>
        )}
        <a href="https://projects.ana-catalina.com" class="hover:text-brand-purple dark:hover:text-brand-purple-light transition-colors">Projects Hub</a>
        <a href="https://linkedin.com/in/ana-catalina/" target="_blank" rel="noopener noreferrer" class="hover:text-brand-purple dark:hover:text-brand-purple-light transition-colors">LinkedIn</a>
      </div>
      <p>&copy; {new Date().getFullYear()} <a href="https://ana-catalina.com" class="hover:text-brand-purple dark:hover:text-brand-purple-light transition-colors font-medium">Ana-Catalina</a></p>
    </footer>

    <!-- Image Lightbox Modal (Zero external dependencies) -->
    <div id="lightbox-modal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden items-center justify-center p-4 sm:p-6" role="dialog" aria-modal="true" aria-label="Screenshot zoom">
      <div class="relative max-w-5xl max-h-[92vh] flex flex-col items-center">
        <button id="lightbox-close" type="button" aria-label={t.close} class="absolute -top-12 right-0 p-2 text-white/80 hover:text-white transition-colors cursor-pointer text-xs font-mono flex items-center gap-1.5 bg-white/10 hover:bg-white/20 rounded-lg px-3 py-1.5 border border-white/10">
          <span>ESC</span>
          <span class="[&>svg]:w-4 [&>svg]:h-4" set:html={iconSvg('X')}></span>
        </button>
        <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[82vh] rounded-xl object-contain shadow-2xl border border-white/10" />
        <p id="lightbox-caption" class="text-white/80 text-xs sm:text-sm font-[Inter] mt-3 text-center"></p>
      </div>
    </div>

    <!-- Interactive Client Scripts (Theme, Lang Rewrite, Tabs, Copy, Lightbox) -->
    <script is:inline define:vars={{ slug, productHost, copiedText: t.copied }}>
      // 1. Theme toggle
      const themeToggle = document.getElementById('theme-toggle');
      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }

      // 2. Language link rewrite and persistence
      const esLink = document.querySelector('[data-lang-link="es"]');
      const enLink = document.querySelector('[data-lang-link="en"]');
      if (esLink) {
        esLink.addEventListener('click', () => {
          localStorage.setItem('lang', 'es');
        });
      }
      if (enLink) {
        enLink.addEventListener('click', () => {
          localStorage.setItem('lang', 'en');
        });
      }
      if (location.hostname !== productHost) {
        if (esLink) esLink.href = `/p/${slug}/`;
        if (enLink) enLink.href = `/p/${slug}/en/`;
      }

      // 3. Interactive Code Snippet Tabs
      const tabButtons = document.querySelectorAll('[data-snippet-tab]');
      const tabContents = document.querySelectorAll('[data-snippet-content]');
      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetIndex = btn.getAttribute('data-snippet-tab');
          tabButtons.forEach((b) => {
            b.classList.remove('bg-white/15', 'text-white', 'font-medium', 'shadow-sm');
            b.classList.add('text-slate-400');
          });
          btn.classList.add('bg-white/15', 'text-white', 'font-medium', 'shadow-sm');
          btn.classList.remove('text-slate-400');

          tabContents.forEach((c) => {
            if (c.getAttribute('data-snippet-content') === targetIndex) {
              c.classList.remove('hidden');
            } else {
              c.classList.add('hidden');
            }
          });
        });
      });

      // 4. Instant Copy Action with Visual Feedback
      const copyButtons = document.querySelectorAll('[data-copy-btn]');
      copyButtons.forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-copy-text');
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            const label = btn.querySelector('.copy-label');
            const originalText = label ? label.textContent : '';
            if (label) label.textContent = copiedText;
            btn.classList.add('bg-emerald-500/20', 'text-emerald-300');
            setTimeout(() => {
              if (label) label.textContent = originalText;
              btn.classList.remove('bg-emerald-500/20', 'text-emerald-300');
            }, 2000);
          } catch (err) {
            console.error('Failed to copy', err);
          }
        });
      });

      // 5. Lightbox Modal Logic
      const modal = document.getElementById('lightbox-modal');
      const modalImg = document.getElementById('lightbox-img');
      const modalCaption = document.getElementById('lightbox-caption');
      const closeBtn = document.getElementById('lightbox-close');

      function openLightbox(src, alt) {
        if (!modal || !modalImg) return;
        modalImg.src = src;
        modalImg.alt = alt || '';
        if (modalCaption) modalCaption.textContent = alt || '';
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        if (!modal) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
      }

      document.querySelectorAll('[data-lightbox-trigger]').forEach((trigger) => {
        const handleOpen = () => {
          const src = trigger.getAttribute('data-lightbox-trigger');
          const alt = trigger.getAttribute('data-lightbox-alt') || '';
          if (src) openLightbox(src, alt);
        };
        trigger.addEventListener('click', handleOpen);
        trigger.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            handleOpen();
          }
        });
      });

      if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeLightbox();
        });
      }
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
          closeLightbox();
        }
      });
    </script>
  </body>
</html>
