---
import '../styles/global.css';
import PoppyBackground from '../components/PoppyBackground.astro';
import Analytics from '@vercel/analytics/astro';
import * as lucide from 'lucide-static';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  lang: 'es' | 'en';
  slug: string;
}

const { entry, lang, slug } = Astro.props;
const { title, icon, githubUrl, websiteUrl } = entry.data;
const product = entry.data.product!;

// The page is served on the project's own subdomain through a host rewrite, so canonical and
// language links point at that host; the ficha lives on projects-hub, hence absolute URLs.
const productHome = (websiteUrl ?? `https://${slug}.ana-catalina.com`).replace(/\/?$/, '/');
const productHost = new URL(productHome).hostname;
const canonicalURL = lang === 'en' ? `${productHome}en` : productHome;
const fichaURL = `https://projects.ana-catalina.com/${lang === 'en' ? 'en/' : ''}${slug}`;
const absoluteIcon = icon ? new URL(icon, 'https://projects.ana-catalina.com').href : undefined;

const t = {
  es: {
    features: 'Qué hace',
    screenshots: 'Así se ve',
    faq: 'Preguntas frecuentes',
    details: 'Ficha técnica',
    source: 'Código en GitHub',
    download: 'Descargar',
    platforms: 'Disponible para',
    theme: 'Cambiar tema',
    copy: 'Copiar',
    copied: '¡Copiado!',
    terminalTitle: 'Consola de Inicio',
  },
  en: {
    features: 'What it does',
    screenshots: 'How it looks',
    faq: 'FAQ',
    details: 'Tech specs',
    source: 'GitHub repo',
    download: 'Download',
    platforms: 'Available for',
    theme: 'Toggle theme',
    copy: 'Copy',
    copied: 'Copied!',
    terminalTitle: 'Quick Start Console',
  },
}[lang];

function iconSvg(name: string): string {
  const svg = (lucide as Record<string, unknown>)[name];
  if (typeof svg !== 'string') throw new Error(`Unknown lucide icon "${name}" in ${entry.id}`);
  return svg;
}

const githubSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>`;

function getLinkIcon(url: string, label: string): string {
  const lowerUrl = url.toLowerCase();
  const lowerLabel = label.toLowerCase();
  if (lowerUrl.includes('catalog') || lowerLabel.includes('catalog') || lowerLabel.includes('herramienta') || lowerLabel.includes('tool')) {
    return 'Boxes';
  }
  if (lowerUrl.includes('quick-start') || lowerUrl.includes('start') || lowerLabel.includes('inicio') || lowerLabel.includes('start') || lowerLabel.includes('consola') || lowerLabel.includes('terminal')) {
    return 'Terminal';
  }
  if (lowerUrl.startsWith('#') || lowerUrl.startsWith('/')) {
    return 'ArrowRight';
  }
  return 'ExternalLink';
}

function renderLinkIcon(url: string, label: string): string {
  if (url.toLowerCase().includes('github.com') || label.toLowerCase().includes('github')) {
    return githubSvg;
  }
  return iconSvg(getLinkIcon(url, label));
}

const customLinks = product.links.filter((link) => !link.url.includes('github.com') && link.url !== githubUrl);

function splitTagline(text: string): { base: string; accent: string } {
  const words = text.trim().split(/\s+/);
  if (words.length <= 2) {
    return { base: words[0] ?? '', accent: words.slice(1).join(' ') };
  }
  const accentCount = Math.max(2, Math.min(3, Math.ceil(words.length * 0.35)));
  const base = words.slice(0, words.length - accentCount).join(' ');
  const accent = words.slice(words.length - accentCount).join(' ');
  return { base, accent };
}

const { base: taglineBase, accent: taglineAccent } = splitTagline(product.tagline);

// -----------------------------------------------------------------------------
// Unified Signature Aura (Pastel-Tech: Tech Lavender & Coral Rose)
// High contrast, harmonious 2-color brand gradient, zero cyan in copy.
// -----------------------------------------------------------------------------
const aura = {
  glowOrb1: 'from-brand-purple/20 via-pastel-lilac/15 to-pastel-blue/15',
  glowOrb2: 'from-pastel-blue/20 via-brand-purple/15 to-pastel-lilac/15',
  textGradient: 'from-brand-purple to-brand-magenta dark:from-brand-purple-light dark:to-brand-magenta',
  badgeBg: 'bg-brand-purple/10 dark:bg-brand-purple/15 border-brand-purple/25 text-brand-purple dark:text-brand-purple-light',
  badgeDot: 'bg-brand-magenta',
  primaryBtn: 'from-brand-purple to-brand-magenta hover:from-brand-purple-light hover:to-brand-magenta shadow-lg shadow-brand-purple/25 hover:shadow-brand-purple/40 hover:-translate-y-0.5 text-white',
  cardBorderHover: 'hover:border-brand-purple/40 hover:shadow-brand-purple/10',
  iconBox: 'bg-brand-purple/15 text-brand-purple dark:text-brand-purple-light border border-brand-purple/20',
  tagBg: 'bg-brand-purple/10 text-brand-purple dark:text-brand-purple-light border-brand-purple/20',
  terminalAccent: 'text-brand-purple-light',
};

const jsonLD = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: title,
  description: product.intro,
  url: canonicalURL,
  operatingSystem: product.platforms.join(', ') || undefined,
  applicationCategory: 'UtilitiesApplication',
  author: { '@type': 'Person', name: 'Ana-Catalina', url: 'https://ana-catalina.com' },
});

const primaryBtnClass = `inline-flex items-center justify-center gap-2 px-6 py-2.5 sm:px-7 sm:py-3 rounded-xl bg-gradient-to-r ${aura.primaryBtn} shadow-md hover:shadow-xl transition-all duration-200 active:scale-95 font-semibold text-sm sm:text-base tracking-wide text-white cursor-pointer select-none`;
const secondaryBtnClass = 'inline-flex items-center justify-center gap-2 px-5 py-2.5 sm:px-6 sm:py-3 rounded-xl bg-white/80 dark:bg-slate-900/80 border border-slate-200/90 dark:border-white/10 text-slate-700 dark:text-slate-200 hover:text-brand-purple dark:hover:text-brand-purple-light hover:bg-white dark:hover:bg-slate-800 hover:border-brand-purple/40 dark:hover:border-brand-purple/40 shadow-sm hover:shadow transition-all duration-200 active:scale-95 font-medium text-sm sm:text-base tracking-wide cursor-pointer select-none backdrop-blur-md';
const cardClass = `group relative rounded-2xl bg-white/70 dark:bg-slate-900/50 backdrop-blur-md border border-slate-200/70 dark:border-white/10 p-6 sm:p-8 shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 ${aura.cardBorderHover}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{`${title} — ${product.tagline}`}</title>
    <meta name="description" content={product.intro} />
    <meta name="author" content="Ana-Catalina" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={productHome} />
    <link rel="alternate" hreflang="en" href={`${productHome}en`} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href={icon ?? '/favicon.svg'} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} — ${product.tagline}`} />
    <meta property="og:description" content={product.intro} />
    {absoluteIcon && <meta property="og:image" content={absoluteIcon} />}
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <script is:inline type="application/ld+json" set:html={jsonLD}></script>
    <script is:inline>
      if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="relative min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 antialiased font-sans overflow-x-hidden selection:bg-brand-purple/20 selection:text-brand-purple dark:selection:text-brand-purple-light">
    <Analytics />

    <!-- Ambient Glowing Light Orbs (Amiga IA Depth & Energy) -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
      <div class:list={['absolute top-[-15%] left-[-10%] w-[55vw] h-[55vw] max-w-[650px] max-h-[650px] rounded-full blur-[130px] opacity-45 dark:opacity-25 bg-gradient-to-br mix-blend-multiply dark:mix-blend-screen transition-opacity duration-500', aura.glowOrb1]}></div>
      <div class:list={['absolute bottom-[-10%] right-[-10%] w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] rounded-full blur-[140px] opacity-45 dark:opacity-25 bg-gradient-to-br mix-blend-multiply dark:mix-blend-screen transition-opacity duration-500', aura.glowOrb2]}></div>
    </div>

    <!-- Ana-Catalina Signature Poppy Watermark (Subtle Brand Identity) -->
    <PoppyBackground />

    <!-- Top Navigation Header -->
    <header class="w-full max-w-6xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between z-20">
      <a href="#top" class="flex items-center gap-3 font-semibold group transition-transform active:scale-95">
        {icon ? (
          <img src={icon} alt="" class="w-9 h-9 rounded-xl object-contain drop-shadow-sm group-hover:scale-105 transition-transform" />
        ) : (
          <div class:list={['w-9 h-9 rounded-xl flex items-center justify-center font-bold text-sm', aura.iconBox]}>
            {title.slice(0, 2).toUpperCase()}
          </div>
        )}
        <span class="tracking-tight text-lg text-slate-900 dark:text-white font-[Outfit]">{title}</span>
      </a>

      <!-- Controls: Language Toggle Pill & Dark Mode Toggle -->
      <div class="flex items-center gap-3">
        <div class="flex items-center bg-white/80 dark:bg-slate-900/70 rounded-full p-1 border border-slate-200/80 dark:border-white/10 shadow-sm backdrop-blur-md relative">
          <div
            id="lang-indicator"
            class="absolute top-1 bottom-1 left-1 bg-brand-purple/15 dark:bg-white/15 rounded-full transition-transform duration-300 ease-out w-[calc(50%-4px)] pointer-events-none"
            style={lang === 'en' ? 'transform: translateX(100%)' : 'transform: translateX(0)'}
          ></div>
          <a
            data-lang-link="es"
            href="/"
            class:list={[
              'relative z-10 w-11 h-7 rounded-full text-xs font-semibold transition-colors flex items-center justify-center',
              lang === 'es' ? 'text-brand-purple dark:text-brand-purple-light' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white',
            ]}
          >
            ES
          </a>
          <a
            data-lang-link="en"
            href="/en"
            class:list={[
              'relative z-10 w-11 h-7 rounded-full text-xs font-semibold transition-colors flex items-center justify-center',
              lang === 'en' ? 'text-brand-purple dark:text-brand-purple-light' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white',
            ]}
          >
            EN
          </a>
        </div>

        <button
          id="theme-toggle"
          type="button"
          aria-label={t.theme}
          class="w-9 h-9 rounded-full flex items-center justify-center bg-white/80 dark:bg-slate-900/70 border border-slate-200/80 dark:border-white/10 backdrop-blur-md text-slate-600 dark:text-slate-300 hover:text-brand-purple dark:hover:text-white hover:border-brand-purple/40 dark:hover:border-white/30 shadow-sm transition-all [&>svg]:w-4 [&>svg]:h-4 cursor-pointer"
          set:html={iconSvg('SunMoon')}
        ></button>
      </div>
    </header>

    <main id="top" class="max-w-6xl mx-auto px-4 sm:px-6 pb-24">
      <!-- Hero Section -->
      <section class="text-center pt-8 sm:pt-14 pb-16 animate-fade-in flex flex-col items-center">
        <!-- Project Hero Logo with Subtle Glass Pedestal -->
        {icon && (
          <div class="mb-6 flex justify-center group">
            <div class="p-1.5 rounded-[28px] bg-gradient-to-b from-white/90 via-white/40 to-white/10 dark:from-white/15 dark:via-white/5 dark:to-transparent border border-white/60 dark:border-white/10 shadow-xl backdrop-blur-md transition-transform duration-300 group-hover:scale-105">
              <img
                src={icon}
                alt={title}
                class="w-24 h-24 sm:w-28 sm:h-28 object-contain rounded-[22px] drop-shadow-[0_8px_20px_rgba(0,0,0,0.1)] dark:drop-shadow-[0_0_30px_rgba(185,141,253,0.3)]"
              />
            </div>
          </div>
        )}

        <!-- Kicker / Eyebrow Badge with Product Name and Platforms -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border mb-6 text-xs font-medium backdrop-blur-md shadow-sm bg-white/70 dark:bg-slate-900/60 border-slate-200/80 dark:border-white/10 text-slate-700 dark:text-slate-200">
          <span class="font-bold text-slate-900 dark:text-white font-[Outfit] tracking-wide">{title}</span>
          <span class="text-slate-300 dark:text-slate-700">|</span>
          <span class:list={['w-2 h-2 rounded-full animate-pulse', aura.badgeDot]}></span>
          <span class="text-slate-600 dark:text-slate-300">{product.platforms.length > 0 ? product.platforms.join(' · ') : (lang === 'es' ? 'Disponible Ahora' : 'Available Now')}</span>
        </div>

        <!-- Headline: Solid High-Contrast Base + Subtle 2-Color Gradient Accent -->
        <h1 class="font-extrabold text-4xl sm:text-6xl md:text-7xl leading-[1.12] sm:leading-[1.14] tracking-tight max-w-4xl font-[Outfit] text-slate-900 dark:text-white">
          {taglineBase}{' '}
          <span class:list={['text-transparent bg-clip-text bg-gradient-to-r inline-block pb-1', aura.textGradient]}>
            {taglineAccent}
          </span>
        </h1>

        <!-- Subtitle / Intro -->
        <p class="mt-6 max-w-2xl mx-auto text-base sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-[Inter]">
          {product.intro}
        </p>

        <!-- Hero CTAs -->
        <div class="mt-8 flex flex-wrap gap-3 sm:gap-3.5 justify-center items-center max-w-2xl mx-auto">
          {product.downloadUrl && (
            <a href={product.downloadUrl} target="_blank" rel="noopener noreferrer" class={primaryBtnClass}>
              <span class="[&>svg]:w-4.5 [&>svg]:h-4.5 shrink-0" set:html={iconSvg('Download')}></span>
              <span>{product.downloadLabel ?? t.download}</span>
            </a>
          )}
          {customLinks.map((link) => (
            <a href={link.url} target={link.url.startsWith('#') ? undefined : '_blank'} rel="noopener noreferrer" class={secondaryBtnClass}>
              <span class="[&>svg]:w-4.5 [&>svg]:h-4.5 shrink-0 opacity-80" set:html={renderLinkIcon(link.url, link.label)}></span>
              <span>{link.label}</span>
            </a>
          ))}
          <a href={fichaURL} class={secondaryBtnClass}>
            <span class="[&>svg]:w-4.5 [&>svg]:h-4.5 shrink-0 opacity-80" set:html={iconSvg('FileText')}></span>
            <span>{t.details}</span>
          </a>
          {githubUrl && (
            <a href={githubUrl} target="_blank" rel="noopener noreferrer" class={secondaryBtnClass}>
              <span class="[&>svg]:w-4.5 [&>svg]:h-4.5 shrink-0 opacity-80" set:html={githubSvg}></span>
              <span>{t.source}</span>
            </a>
          )}
        </div>
      </section>

      <!-- Features Grid (Centered Flex Bento) -->
      <section class="py-14" aria-labelledby="features-title">
        <div class="text-center mb-12">
          <h2 id="features-title" class="font-bold text-3xl sm:text-4xl text-slate-900 dark:text-white font-[Outfit] tracking-tight">
            {t.features}
          </h2>
        </div>
        <div class="flex flex-wrap justify-center gap-6">
          {product.features.map((feature) => (
            <article class:list={[cardClass, 'w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)] flex flex-col']}>
              <span class:list={['inline-flex w-12 h-12 items-center justify-center rounded-xl backdrop-blur-sm transition-transform duration-300 group-hover:scale-110 mb-5 [&>svg]:w-6 [&>svg]:h-6 shadow-sm', aura.iconBox]} set:html={iconSvg(feature.icon)}></span>
              <h3 class="font-semibold text-xl text-slate-900 dark:text-white font-[Outfit] tracking-tight">{feature.title}</h3>
              <p class="mt-2.5 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed font-[Inter]">{feature.text}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Catalog / Utility Groups Section (Centered Flex Bento) -->
      {product.catalog && (
        <section id="catalog" class="py-14 scroll-mt-24" aria-labelledby="catalog-title">
          <div class="text-center mb-12">
            <h2 id="catalog-title" class="font-bold text-3xl sm:text-4xl text-slate-900 dark:text-white font-[Outfit] tracking-tight">
              {product.catalog.title}
            </h2>
          </div>
          <div class="flex flex-wrap justify-center gap-6">
            {product.catalog.items.map((item) => (
              <article class="w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)] rounded-2xl bg-white/70 dark:bg-slate-900/50 backdrop-blur-md border border-slate-200/70 dark:border-white/10 flex flex-col hover:border-brand-purple/40 dark:hover:border-brand-purple/40 transition-all shadow-sm hover:shadow-lg overflow-hidden group">
                <div class="p-6 pb-4">
                  <h3 class="font-mono text-base font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-2">
                    <span class:list={['w-2 h-2 rounded-full', aura.badgeDot]}></span>
                    {item.title}
                  </h3>
                  <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed font-[Inter]">{item.description}</p>
                </div>
                {item.tags.length > 0 && (
                  <div class="bg-slate-100/60 dark:bg-black/30 p-4 mt-auto border-t border-slate-200/60 dark:border-white/5">
                    <div class="flex flex-wrap gap-1.5">
                      {item.tags.map((tag) => (
                        <span class:list={['px-2.5 py-0.5 rounded-md text-xs font-mono border backdrop-blur-sm', aura.tagBg]}>
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>
      )}

      <!-- DevTools / Quick Start Terminal (Minimalist Monochromatic Console) -->
      {product.codeSnippets.length > 0 && (
        <section id="quick-start" class="py-14 scroll-mt-24 max-w-3xl mx-auto" aria-labelledby="quickstart-title">
          <div class="text-center mb-8">
            <h2 id="quickstart-title" class="font-bold text-3xl text-slate-900 dark:text-white font-[Outfit] tracking-tight">
              {t.terminalTitle}
            </h2>
          </div>

          <div class="w-full rounded-2xl bg-slate-950 text-slate-200 border border-slate-800/80 shadow-2xl overflow-hidden font-mono backdrop-blur-xl">
            <!-- Terminal Window Header (Minimalist Monochromatic) -->
            <div class="flex items-center justify-between px-4 sm:px-5 py-3 bg-slate-900/80 border-b border-slate-800/80">
              <div class="flex items-center gap-2 text-xs text-slate-400 select-none font-mono">
                <span class="text-slate-500 font-bold">&gt;_</span>
                <span>terminal — {title}</span>
              </div>

              <!-- Interactive Tabs (When Multiple Snippets Exist) -->
              {product.codeSnippets.length > 1 && (
                <div class="flex items-center gap-1 bg-slate-950/70 p-1 rounded-lg border border-slate-850">
                  {product.codeSnippets.map((snippet, idx) => (
                    <button
                      type="button"
                      data-snippet-tab={idx}
                      class:list={[
                        'px-2.5 py-1 rounded text-xs transition-colors cursor-pointer',
                        idx === 0 ? 'bg-white/15 text-white font-medium shadow-sm' : 'text-slate-400 hover:text-slate-200',
                      ]}
                    >
                      {snippet.title}
                    </button>
                  ))}
                </div>
              )}
            </div>

            <!-- Snippets Content -->
            {product.codeSnippets.map((snippet, idx) => (
              <div data-snippet-content={idx} class:list={['p-5 sm:p-6 text-sm relative group', idx !== 0 && 'hidden']}>
                {product.codeSnippets.length === 1 && (
                  <div class="text-xs text-slate-400 mb-3 font-semibold uppercase tracking-wider">{snippet.title}</div>
                )}
                <div class="flex items-start justify-between gap-4">
                  <pre class="overflow-x-auto text-slate-100 flex-1 leading-relaxed"><code class={`language-${snippet.language}`}>{snippet.code.trim()}</code></pre>
                  <button
                    type="button"
                    data-copy-btn
                    data-copy-text={snippet.code.trim()}
                    aria-label={t.copy}
                    class="shrink-0 p-2 rounded-lg bg-white/10 hover:bg-white/20 text-slate-300 hover:text-white transition-all cursor-pointer flex items-center gap-1.5 text-xs font-sans border border-white/5"
                  >
                    <span class="copy-icon [&>svg]:w-4 [&>svg]:h-4" set:html={iconSvg('Copy')}></span>
                    <span class="copy-label hidden sm:inline">{t.copy}</span>
                  </button>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Notice Aside -->
      {product.notice && (
        <aside class:list={['my-12 rounded-2xl p-6 sm:p-8 border backdrop-blur-md shadow-sm', aura.badgeBg]}>
          <h2 class="font-semibold text-lg font-[Outfit] text-slate-900 dark:text-white flex items-center gap-2">
            <span class="[&>svg]:w-5 [&>svg]:h-5" set:html={iconSvg('Info')}></span>
            {product.notice.title}
          </h2>
          <p class="mt-2 text-sm sm:text-base leading-relaxed font-[Inter] opacity-90">{product.notice.text}</p>
        </aside>
      )}

      <!-- Screenshots Gallery -->
      {product.screenshots.length > 0 && (
        <section class="py-14" aria-labelledby="screens-title">
          <div class="text-center mb-12">
            <h2 id="screens-title" class="font-bold text-3xl sm:text-4xl text-slate-900 dark:text-white font-[Outfit] tracking-tight">
              {t.screenshots}
            </h2>
          </div>
          <div class="flex flex-wrap gap-8 justify-center">
            {product.screenshots.map((shot) => (
              <div class="group relative rounded-2xl p-1.5 sm:p-2 bg-gradient-to-b from-white/80 via-slate-200/50 to-white/30 dark:from-white/10 dark:via-white/5 dark:to-transparent border border-slate-200/80 dark:border-white/10 shadow-xl dark:shadow-2xl dark:shadow-black/60 transition-all duration-300 hover:scale-[1.015] hover:border-brand-purple/40">
                <img
                  src={shot.src}
                  alt={shot.alt}
                  loading="lazy"
                  class="max-h-[560px] w-auto max-w-full rounded-xl object-contain block shadow-sm"
                />
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- FAQ Section -->
      {product.faq.length > 0 && (
        <section class="py-14 max-w-3xl mx-auto" aria-labelledby="faq-title">
          <div class="text-center mb-12">
            <h2 id="faq-title" class="font-bold text-3xl sm:text-4xl text-slate-900 dark:text-white font-[Outfit] tracking-tight">
              {t.faq}
            </h2>
          </div>
          <div class="space-y-4">
            {product.faq.map((item) => (
              <details class="group rounded-2xl bg-white/70 dark:bg-slate-900/50 backdrop-blur-md border border-slate-200/80 dark:border-white/10 px-6 py-4.5 shadow-sm hover:border-slate-300 dark:hover:border-white/25 transition-all">
                <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white list-none flex justify-between items-center gap-4 text-base sm:text-lg font-[Outfit]">
                  <span>{item.question}</span>
                  <span class:list={['text-lg font-bold group-open:rotate-45 transition-transform duration-200', aura.terminalAccent]}>+</span>
                </summary>
                <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-300 font-[Inter] leading-relaxed">{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- Bottom Download CTA -->
      {product.downloadUrl && (
        <section class="py-16 text-center">
          <a href={product.downloadUrl} target="_blank" rel="noopener noreferrer" class={primaryBtnClass}>
            <span class="[&>svg]:w-4.5 [&>svg]:h-4.5 shrink-0" set:html={iconSvg('Download')}></span>
            <span>{product.downloadLabel ?? t.download}</span>
          </a>
        </section>
      )}
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200/80 dark:border-white/10 py-10 text-center text-xs text-slate-500 dark:text-slate-400 font-[Inter] backdrop-blur-sm">
      <div class="flex justify-center flex-wrap gap-6 mb-4 font-medium">
        <a href={fichaURL} class="hover:text-brand-purple dark:hover:text-brand-purple-light transition-colors">{t.details}</a>
        {githubUrl && (
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-brand-purple dark:hover:text-brand-purple-light transition-colors">
            {t.source}
          </a>
        )}
        <a href="https://projects.ana-catalina.com" class="hover:text-brand-purple dark:hover:text-brand-purple-light transition-colors">Projects Hub</a>
      </div>
      <p>&copy; {new Date().getFullYear()} <a href="https://ana-catalina.com" class="hover:text-brand-purple dark:hover:text-brand-purple-light transition-colors font-medium">Ana-Catalina</a></p>
    </footer>

    <!-- Interactive Client Scripts (Theme, Lang Rewrite, Tabs, Copy) -->
    <script is:inline define:vars={{ slug, productHost, copiedText: t.copied }}>
      // 1. Theme toggle
      const themeToggle = document.getElementById('theme-toggle');
      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }

      // 2. Language link rewrite for previews / non-subdomain visits
      if (location.hostname !== productHost) {
        const esLink = document.querySelector('[data-lang-link="es"]');
        const enLink = document.querySelector('[data-lang-link="en"]');
        if (esLink) esLink.href = `/p/${slug}/`;
        if (enLink) enLink.href = `/p/${slug}/en/`;
      }

      // 3. Interactive Code Snippet Tabs
      const tabButtons = document.querySelectorAll('[data-snippet-tab]');
      const tabContents = document.querySelectorAll('[data-snippet-content]');
      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetIndex = btn.getAttribute('data-snippet-tab');
          tabButtons.forEach((b) => {
            b.classList.remove('bg-white/15', 'text-white', 'font-medium', 'shadow-sm');
            b.classList.add('text-slate-400');
          });
          btn.classList.add('bg-white/15', 'text-white', 'font-medium', 'shadow-sm');
          btn.classList.remove('text-slate-400');

          tabContents.forEach((c) => {
            if (c.getAttribute('data-snippet-content') === targetIndex) {
              c.classList.remove('hidden');
            } else {
              c.classList.add('hidden');
            }
          });
        });
      });

      // 4. Instant Copy Action with Visual Feedback
      const copyButtons = document.querySelectorAll('[data-copy-btn]');
      copyButtons.forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-copy-text');
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            const label = btn.querySelector('.copy-label');
            const originalText = label ? label.textContent : '';
            if (label) label.textContent = copiedText;
            btn.classList.add('bg-emerald-500/20', 'text-emerald-300');
            setTimeout(() => {
              if (label) label.textContent = originalText;
              btn.classList.remove('bg-emerald-500/20', 'text-emerald-300');
            }, 2000);
          } catch (err) {
            console.error('Failed to copy', err);
          }
        });
      });
    </script>
  </body>
</html>
