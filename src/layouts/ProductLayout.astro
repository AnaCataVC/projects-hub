---
import '../styles/global.css';
import PoppyBackground from '../components/PoppyBackground.astro';
import Analytics from '@vercel/analytics/astro';
import * as lucide from 'lucide-static';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  lang: 'es' | 'en';
  slug: string;
}

const { entry, lang, slug } = Astro.props;
const { title, icon, githubUrl, websiteUrl, type, categories = [] } = entry.data;
const product = entry.data.product!;

// The page is served on the project's own subdomain through a host rewrite, so canonical and
// language links point at that host; the ficha lives on projects-hub, hence absolute URLs.
const productHome = (websiteUrl ?? `https://${slug}.ana-catalina.com`).replace(/\/?$/, '/');
const productHost = new URL(productHome).hostname;
const canonicalURL = lang === 'en' ? `${productHome}en` : productHome;
const fichaURL = `https://projects.ana-catalina.com/${lang === 'en' ? 'en/' : ''}${slug}`;
const absoluteIcon = icon ? new URL(icon, 'https://projects.ana-catalina.com').href : undefined;

const t = {
  es: {
    features: 'Qué hace',
    screenshots: 'Así se ve',
    faq: 'Preguntas frecuentes',
    details: 'Ficha técnica',
    source: 'Código en GitHub',
    download: 'Descargar',
    platforms: 'Disponible para',
    theme: 'Cambiar tema',
    copy: 'Copiar',
    copied: '¡Copiado!',
    terminalTitle: 'Consola de Inicio',
  },
  en: {
    features: 'What it does',
    screenshots: 'How it looks',
    faq: 'FAQ',
    details: 'Tech specs',
    source: 'GitHub repo',
    download: 'Download',
    platforms: 'Available for',
    theme: 'Toggle theme',
    copy: 'Copy',
    copied: 'Copied!',
    terminalTitle: 'Quick Start Console',
  },
}[lang];

function iconSvg(name: string): string {
  const svg = (lucide as Record<string, unknown>)[name];
  if (typeof svg !== 'string') throw new Error(`Unknown lucide icon "${name}" in ${entry.id}`);
  return svg;
}

// -----------------------------------------------------------------------------
// Dynamic Accent Aura per Software Archetype (Amiga IA Persona + Color Harmony)
// -----------------------------------------------------------------------------
type Aura = {
  glowOrb1: string;
  glowOrb2: string;
  textGradient: string;
  badgeBg: string;
  badgeDot: string;
  primaryBtn: string;
  cardBorderHover: string;
  iconBox: string;
  tagBg: string;
  terminalAccent: string;
};

function getAura(projType: string, cats: string[], projSlug: string): Aura {
  const isHealthOrTimer =
    ['screen-health-guardian', 'meds-reminder', 'rest-your-eyes', 'prima-focus', 'little-chef-timer'].includes(projSlug) ||
    cats.some((c) => /salud|eyes|ojos|timer|focus|health|bienestar/i.test(c));

  const isAI =
    projType === 'ai' ||
    cats.some((c) => /ia|agentes|ai|agent/i.test(c)) ||
    ['amiga-ia', 'anacatalina-mcp', 'cute-agents-desk'].includes(projSlug);

  const isDesktop =
    projType === 'desktop' ||
    cats.some((c) => /desktop|sistema|windows|system/i.test(c)) ||
    ['system-core-monitor', 'windows-icons-admin', 'workspace-companion'].includes(projSlug);

  if (isAI) {
    return {
      glowOrb1: 'from-pink-500/25 via-fuchsia-500/20 to-purple-600/20',
      glowOrb2: 'from-purple-600/20 via-indigo-600/25 to-blue-600/20',
      textGradient: 'from-pink-500 via-fuchsia-500 to-indigo-500 dark:from-pink-400 dark:via-fuchsia-300 dark:to-indigo-300',
      badgeBg: 'bg-pink-500/10 dark:bg-pink-500/15 border-pink-500/25 text-pink-600 dark:text-pink-300',
      badgeDot: 'bg-pink-500',
      primaryBtn: 'from-pink-500 via-purple-600 to-indigo-600 hover:from-pink-600 hover:via-purple-700 hover:to-indigo-700 shadow-pink-500/25 hover:shadow-pink-500/40 text-white',
      cardBorderHover: 'hover:border-pink-500/40 hover:shadow-pink-500/10',
      iconBox: 'bg-pink-500/15 text-pink-600 dark:text-pink-300',
      tagBg: 'bg-pink-500/10 text-pink-700 dark:text-pink-300 border-pink-500/20',
      terminalAccent: 'text-pink-400',
    };
  }

  if (isHealthOrTimer) {
    return {
      glowOrb1: 'from-emerald-500/25 via-teal-500/20 to-cyan-600/20',
      glowOrb2: 'from-cyan-600/20 via-teal-600/25 to-emerald-600/20',
      textGradient: 'from-emerald-500 via-teal-500 to-cyan-600 dark:from-emerald-300 dark:via-teal-300 dark:to-cyan-400',
      badgeBg: 'bg-emerald-500/10 dark:bg-emerald-500/15 border-emerald-500/25 text-emerald-600 dark:text-emerald-300',
      badgeDot: 'bg-emerald-400',
      primaryBtn: 'from-emerald-500 via-teal-600 to-cyan-600 hover:from-emerald-600 hover:via-teal-700 hover:to-cyan-700 shadow-emerald-500/25 hover:shadow-emerald-500/40 text-white',
      cardBorderHover: 'hover:border-emerald-500/40 hover:shadow-emerald-500/10',
      iconBox: 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-300',
      tagBg: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border-emerald-500/20',
      terminalAccent: 'text-emerald-400',
    };
  }

  if (isDesktop) {
    return {
      glowOrb1: 'from-cyan-500/25 via-blue-500/20 to-indigo-600/20',
      glowOrb2: 'from-indigo-600/20 via-blue-600/25 to-cyan-600/20',
      textGradient: 'from-cyan-500 via-blue-500 to-indigo-600 dark:from-cyan-300 dark:via-blue-400 dark:to-indigo-300',
      badgeBg: 'bg-cyan-500/10 dark:bg-cyan-500/15 border-cyan-500/25 text-cyan-600 dark:text-cyan-300',
      badgeDot: 'bg-cyan-400',
      primaryBtn: 'from-cyan-500 via-blue-600 to-indigo-600 hover:from-cyan-600 hover:via-blue-700 hover:to-indigo-700 shadow-cyan-500/25 hover:shadow-cyan-500/40 text-white',
      cardBorderHover: 'hover:border-cyan-500/40 hover:shadow-cyan-500/10',
      iconBox: 'bg-cyan-500/15 text-cyan-600 dark:text-cyan-300',
      tagBg: 'bg-cyan-500/10 text-cyan-700 dark:text-cyan-300 border-cyan-500/20',
      terminalAccent: 'text-cyan-400',
    };
  }

  // Default: Web / Utilities / Productivity
  return {
    glowOrb1: 'from-purple-500/25 via-indigo-500/20 to-pink-500/20',
    glowOrb2: 'from-pink-500/20 via-purple-600/25 to-indigo-600/20',
    textGradient: 'from-purple-500 via-indigo-500 to-pink-500 dark:from-purple-300 dark:via-indigo-300 dark:to-pink-300',
    badgeBg: 'bg-purple-500/10 dark:bg-purple-500/15 border-purple-500/25 text-purple-600 dark:text-purple-300',
    badgeDot: 'bg-purple-400',
    primaryBtn: 'from-purple-500 via-indigo-600 to-pink-600 hover:from-purple-600 hover:via-indigo-700 hover:to-pink-700 shadow-purple-500/25 hover:shadow-purple-500/40 text-white',
    cardBorderHover: 'hover:border-purple-500/40 hover:shadow-purple-500/10',
    iconBox: 'bg-purple-500/15 text-purple-600 dark:text-purple-300',
    tagBg: 'bg-purple-500/10 text-purple-700 dark:text-purple-300 border-purple-500/20',
    terminalAccent: 'text-purple-400',
  };
}

const aura = getAura(type, categories, slug);

const jsonLD = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: title,
  description: product.intro,
  url: canonicalURL,
  operatingSystem: product.platforms.join(', ') || undefined,
  applicationCategory: 'UtilitiesApplication',
  author: { '@type': 'Person', name: 'Ana-Catalina', url: 'https://ana-catalina.com' },
});

const primaryBtnClass = `inline-flex items-center justify-center gap-2.5 px-8 sm:px-10 py-3.5 sm:py-4 rounded-2xl bg-gradient-to-r ${aura.primaryBtn} shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 active:translate-y-0 tracking-wide font-semibold text-sm sm:text-base cursor-pointer`;
const secondaryBtnClass = 'inline-flex items-center justify-center gap-2.5 px-8 sm:px-10 py-3.5 sm:py-4 rounded-2xl bg-white/80 dark:bg-slate-900/60 border border-slate-200/80 dark:border-white/10 backdrop-blur-md shadow-sm hover:shadow-md hover:border-slate-300 dark:hover:border-white/25 transition-all duration-300 transform hover:-translate-y-0.5 text-slate-700 dark:text-slate-200 tracking-wide font-medium text-sm sm:text-base cursor-pointer';
const cardClass = `group relative rounded-2xl bg-white/70 dark:bg-slate-900/50 backdrop-blur-md border border-slate-200/70 dark:border-white/10 p-6 sm:p-8 shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 ${aura.cardBorderHover}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{`${title} — ${product.tagline}`}</title>
    <meta name="description" content={product.intro} />
    <meta name="author" content="Ana-Catalina" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={productHome} />
    <link rel="alternate" hreflang="en" href={`${productHome}en`} />
    <link rel="icon" href={icon ?? '/favicon.svg'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} — ${product.tagline}`} />
    <meta property="og:description" content={product.intro} />
    {absoluteIcon && <meta property="og:image" content={absoluteIcon} />}
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <script is:inline type="application/ld+json" set:html={jsonLD}></script>
    <script is:inline>
      if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="relative min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 antialiased font-sans overflow-x-hidden selection:bg-purple-500/20 selection:text-purple-600 dark:selection:text-purple-300">
    <Analytics />

    <!-- Ambient Glowing Light Orbs (Amiga IA Depth & Energy) -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
      <div class:list={['absolute top-[-15%] left-[-10%] w-[55vw] h-[55vw] max-w-[650px] max-h-[650px] rounded-full blur-[130px] opacity-45 dark:opacity-25 bg-gradient-to-br mix-blend-multiply dark:mix-blend-screen transition-opacity duration-500', aura.glowOrb1]}></div>
      <div class:list={['absolute bottom-[-10%] right-[-10%] w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] rounded-full blur-[140px] opacity-45 dark:opacity-25 bg-gradient-to-br mix-blend-multiply dark:mix-blend-screen transition-opacity duration-500', aura.glowOrb2]}></div>
    </div>

    <!-- Ana-Catalina Signature Poppy Watermark (Subtle Brand Identity) -->
    <PoppyBackground />

    <!-- Top Navigation Header -->
    <header class="w-full max-w-6xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between z-20">
      <a href="#top" class="flex items-center gap-3 font-semibold group transition-transform active:scale-95">
        {icon ? (
          <img src={icon} alt="" class="w-9 h-9 rounded-xl object-contain drop-shadow-sm group-hover:scale-105 transition-transform" />
        ) : (
          <div class:list={['w-9 h-9 rounded-xl flex items-center justify-center font-bold text-sm', aura.iconBox]}>
            {title.slice(0, 2).toUpperCase()}
          </div>
        )}
        <span class="tracking-tight text-lg text-slate-900 dark:text-white font-[Outfit]">{title}</span>
      </a>

      <!-- Controls: Language Toggle Pill & Dark Mode Toggle -->
      <div class="flex items-center gap-3">
        <div class="flex items-center bg-white/80 dark:bg-slate-900/70 rounded-full p-1 border border-slate-200/80 dark:border-white/10 shadow-sm backdrop-blur-md relative">
          <div
            id="lang-indicator"
            class="absolute top-1 bottom-1 left-1 bg-purple-500/15 dark:bg-white/15 rounded-full transition-transform duration-300 ease-out w-[calc(50%-4px)] pointer-events-none"
            style={lang === 'en' ? 'transform: translateX(100%)' : 'transform: translateX(0)'}
          ></div>
          <a
            data-lang-link="es"
            href="/"
            class:list={[
              'relative z-10 w-11 h-7 rounded-full text-xs font-semibold transition-colors flex items-center justify-center',
              lang === 'es' ? 'text-purple-700 dark:text-white' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white',
            ]}
          >
            ES
          </a>
          <a
            data-lang-link="en"
            href="/en"
            class:list={[
              'relative z-10 w-11 h-7 rounded-full text-xs font-semibold transition-colors flex items-center justify-center',
              lang === 'en' ? 'text-purple-700 dark:text-white' : 'text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white',
            ]}
          >
            EN
          </a>
        </div>

        <button
          id="theme-toggle"
          type="button"
          aria-label={t.theme}
          class="w-9 h-9 rounded-full flex items-center justify-center bg-white/80 dark:bg-slate-900/70 border border-slate-200/80 dark:border-white/10 backdrop-blur-md text-slate-600 dark:text-slate-300 hover:text-purple-600 dark:hover:text-white hover:border-purple-300 dark:hover:border-white/30 shadow-sm transition-all [&>svg]:w-4 [&>svg]:h-4 cursor-pointer"
          set:html={iconSvg('SunMoon')}
        ></button>
      </div>
    </header>

    <main id="top" class="max-w-6xl mx-auto px-4 sm:px-6 pb-24">
      <!-- Hero Section -->
      <section class="text-center pt-10 sm:pt-16 pb-16 animate-fade-in flex flex-col items-center">
        <!-- Project Hero Logo with Glow -->
        {icon && (
          <div class="mb-6 flex justify-center">
            <img
              src={icon}
              alt={title}
              class="w-24 h-24 sm:w-28 sm:h-28 object-contain rounded-3xl drop-shadow-[0_10px_25px_rgba(0,0,0,0.12)] dark:drop-shadow-[0_0_35px_rgba(168,85,247,0.35)] hover:scale-105 transition-transform duration-300"
            />
          </div>
        )}

        <!-- Status / Platform Pill Badge with Pulsing Beacon -->
        <div class:list={['inline-flex items-center gap-2 px-4 py-1.5 rounded-full border mb-6 text-xs font-medium backdrop-blur-md shadow-sm', aura.badgeBg]}>
          <span class:list={['w-2 h-2 rounded-full animate-pulse', aura.badgeDot]}></span>
          <span>{product.platforms.length > 0 ? product.platforms.join(' · ') : (lang === 'es' ? 'Disponible Ahora' : 'Available Now')}</span>
        </div>

        <!-- Headline with Signature Gradient -->
        <h1 class="font-extrabold text-4xl sm:text-6xl md:text-7xl leading-[1.12] tracking-tight max-w-4xl font-[Outfit]">
          <span class:list={['text-transparent bg-clip-text bg-gradient-to-r block pb-2', aura.textGradient]}>
            {product.tagline}
          </span>
        </h1>

        <!-- Subtitle / Intro -->
        <p class="mt-6 max-w-2xl mx-auto text-base sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-[Inter]">
          {product.intro}
        </p>

        <!-- Hero CTAs -->
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center w-full max-w-md sm:max-w-none">
          {product.downloadUrl && (
            <a href={product.downloadUrl} target="_blank" rel="noopener noreferrer" class={primaryBtnClass}>
              <span class="[&>svg]:w-5 [&>svg]:h-5" set:html={iconSvg('Download')}></span>
              <span>{product.downloadLabel ?? t.download}</span>
            </a>
          )}
          {product.links.map((link) => (
            <a href={link.url} target={link.url.startsWith('#') ? undefined : '_blank'} rel="noopener noreferrer" class={secondaryBtnClass}>
              {link.label}
            </a>
          ))}
          <a href={fichaURL} class={secondaryBtnClass}>
            <span class="[&>svg]:w-4 [&>svg]:h-4 opacity-75" set:html={iconSvg('FileText')}></span>
            <span>{t.details}</span>
          </a>
        </div>
      </section>

      <!-- Features Grid (Glassmorphism Cards) -->
      <section class="py-14" aria-labelledby="features-title">
        <div class="text-center mb-12">
          <h2 id="features-title" class="font-bold text-3xl sm:text-4xl text-slate-900 dark:text-white font-[Outfit] tracking-tight">
            {t.features}
          </h2>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {product.features.map((feature) => (
            <article class={cardClass}>
              <span class:list={['inline-flex w-12 h-12 items-center justify-center rounded-xl backdrop-blur-sm transition-transform duration-300 group-hover:scale-110 mb-5 [&>svg]:w-6 [&>svg]:h-6', aura.iconBox]} set:html={iconSvg(feature.icon)}></span>
              <h3 class="font-semibold text-xl text-slate-900 dark:text-white font-[Outfit] tracking-tight">{feature.title}</h3>
              <p class="mt-2.5 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed font-[Inter]">{feature.text}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Catalog / Utility Groups Section (Amiga IA Style) -->
      {product.catalog && (
        <section id="catalog" class="py-14 scroll-mt-24" aria-labelledby="catalog-title">
          <div class="text-center mb-12">
            <h2 id="catalog-title" class="font-bold text-3xl sm:text-4xl text-slate-900 dark:text-white font-[Outfit] tracking-tight">
              {product.catalog.title}
            </h2>
          </div>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {product.catalog.items.map((item) => (
              <article class="rounded-2xl bg-white/70 dark:bg-slate-900/50 backdrop-blur-md border border-slate-200/70 dark:border-white/10 flex flex-col hover:border-slate-300 dark:hover:border-white/20 transition-all shadow-sm hover:shadow-lg overflow-hidden group">
                <div class="p-6 pb-4">
                  <h3 class="font-mono text-base font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-2">
                    <span class:list={['w-2 h-2 rounded-full', aura.badgeDot]}></span>
                    {item.title}
                  </h3>
                  <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed font-[Inter]">{item.description}</p>
                </div>
                {item.tags.length > 0 && (
                  <div class="bg-slate-100/60 dark:bg-black/30 p-4 mt-auto border-t border-slate-200/60 dark:border-white/5">
                    <div class="flex flex-wrap gap-1.5">
                      {item.tags.map((tag) => (
                        <span class:list={['px-2.5 py-0.5 rounded-md text-xs font-mono border backdrop-blur-sm', aura.tagBg]}>
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>
      )}

      <!-- DevTools / Quick Start Terminal (with Interactive Tabs & Copy Action) -->
      {product.codeSnippets.length > 0 && (
        <section id="quick-start" class="py-14 scroll-mt-24 max-w-3xl mx-auto" aria-labelledby="quickstart-title">
          <div class="text-center mb-8">
            <h2 id="quickstart-title" class="font-bold text-3xl text-slate-900 dark:text-white font-[Outfit] tracking-tight">
              {t.terminalTitle}
            </h2>
          </div>

          <div class="w-full rounded-2xl bg-slate-950 text-slate-200 border border-slate-800 shadow-2xl overflow-hidden font-mono backdrop-blur-xl">
            <!-- Terminal Window Header -->
            <div class="flex items-center justify-between px-4 py-3 bg-slate-900/90 border-b border-slate-800">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
                <span class="ml-2 text-xs text-slate-400 select-none hidden sm:inline">bash — {title}</span>
              </div>

              <!-- Interactive Tabs (When Multiple Snippets Exist) -->
              {product.codeSnippets.length > 1 && (
                <div class="flex items-center gap-1 bg-slate-950/70 p-1 rounded-lg border border-slate-800">
                  {product.codeSnippets.map((snippet, idx) => (
                    <button
                      type="button"
                      data-snippet-tab={idx}
                      class:list={[
                        'px-2.5 py-1 rounded text-xs transition-colors cursor-pointer',
                        idx === 0 ? 'bg-white/15 text-white font-medium shadow-sm' : 'text-slate-400 hover:text-slate-200',
                      ]}
                    >
                      {snippet.title}
                    </button>
                  ))}
                </div>
              )}
            </div>

            <!-- Snippets Content -->
            {product.codeSnippets.map((snippet, idx) => (
              <div data-snippet-content={idx} class:list={['p-5 sm:p-6 text-sm relative group', idx !== 0 && 'hidden']}>
                {product.codeSnippets.length === 1 && (
                  <div class="text-xs text-slate-400 mb-3 font-semibold uppercase tracking-wider">{snippet.title}</div>
                )}
                <div class="flex items-start justify-between gap-4">
                  <pre class="overflow-x-auto text-slate-100 flex-1 leading-relaxed"><code class={`language-${snippet.language}`}>{snippet.code.trim()}</code></pre>
                  <button
                    type="button"
                    data-copy-btn
                    data-copy-text={snippet.code.trim()}
                    aria-label={t.copy}
                    class="shrink-0 p-2 rounded-lg bg-white/10 hover:bg-white/20 text-slate-300 hover:text-white transition-all cursor-pointer flex items-center gap-1.5 text-xs font-sans"
                  >
                    <span class="copy-icon [&>svg]:w-4 [&>svg]:h-4" set:html={iconSvg('Copy')}></span>
                    <span class="copy-label hidden sm:inline">{t.copy}</span>
                  </button>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Notice Aside -->
      {product.notice && (
        <aside class:list={['my-12 rounded-2xl p-6 sm:p-8 border backdrop-blur-md shadow-sm', aura.badgeBg]}>
          <h2 class="font-semibold text-lg font-[Outfit] text-slate-900 dark:text-white flex items-center gap-2">
            <span class="[&>svg]:w-5 [&>svg]:h-5" set:html={iconSvg('Info')}></span>
            {product.notice.title}
          </h2>
          <p class="mt-2 text-sm sm:text-base leading-relaxed font-[Inter] opacity-90">{product.notice.text}</p>
        </aside>
      )}

      <!-- Screenshots Gallery -->
      {product.screenshots.length > 0 && (
        <section class="py-14" aria-labelledby="screens-title">
          <div class="text-center mb-12">
            <h2 id="screens-title" class="font-bold text-3xl sm:text-4xl text-slate-900 dark:text-white font-[Outfit] tracking-tight">
              {t.screenshots}
            </h2>
          </div>
          <div class="flex flex-wrap gap-8 justify-center">
            {product.screenshots.map((shot) => (
              <img
                src={shot.src}
                alt={shot.alt}
                loading="lazy"
                class="max-h-[560px] w-auto max-w-full rounded-2xl border border-slate-200/80 dark:border-white/15 shadow-xl dark:shadow-2xl dark:shadow-purple-950/20 hover:scale-[1.01] transition-transform duration-300"
              />
            ))}
          </div>
        </section>
      )}

      <!-- FAQ Section -->
      {product.faq.length > 0 && (
        <section class="py-14 max-w-3xl mx-auto" aria-labelledby="faq-title">
          <div class="text-center mb-12">
            <h2 id="faq-title" class="font-bold text-3xl sm:text-4xl text-slate-900 dark:text-white font-[Outfit] tracking-tight">
              {t.faq}
            </h2>
          </div>
          <div class="space-y-4">
            {product.faq.map((item) => (
              <details class="group rounded-2xl bg-white/70 dark:bg-slate-900/50 backdrop-blur-md border border-slate-200/80 dark:border-white/10 px-6 py-4.5 shadow-sm hover:border-slate-300 dark:hover:border-white/25 transition-all">
                <summary class="cursor-pointer font-semibold text-slate-900 dark:text-white list-none flex justify-between items-center gap-4 text-base sm:text-lg font-[Outfit]">
                  <span>{item.question}</span>
                  <span class:list={['text-lg font-bold group-open:rotate-45 transition-transform duration-200', aura.terminalAccent]}>+</span>
                </summary>
                <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-300 font-[Inter] leading-relaxed">{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- Bottom Download CTA -->
      {product.downloadUrl && (
        <section class="py-16 text-center">
          <a href={product.downloadUrl} target="_blank" rel="noopener noreferrer" class={primaryBtnClass}>
            <span class="[&>svg]:w-5 [&>svg]:h-5" set:html={iconSvg('Download')}></span>
            <span>{product.downloadLabel ?? t.download}</span>
          </a>
        </section>
      )}
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200/80 dark:border-white/10 py-10 text-center text-xs text-slate-500 dark:text-slate-400 font-[Inter] backdrop-blur-sm">
      <div class="flex justify-center flex-wrap gap-6 mb-4 font-medium">
        <a href={fichaURL} class="hover:text-purple-600 dark:hover:text-purple-300 transition-colors">{t.details}</a>
        {githubUrl && (
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-purple-600 dark:hover:text-purple-300 transition-colors">
            {t.source}
          </a>
        )}
        <a href="https://projects.ana-catalina.com" class="hover:text-purple-600 dark:hover:text-purple-300 transition-colors">Projects Hub</a>
      </div>
      <p>&copy; {new Date().getFullYear()} <a href="https://ana-catalina.com" class="hover:text-purple-600 dark:hover:text-purple-300 transition-colors font-medium">Ana-Catalina</a></p>
    </footer>

    <!-- Interactive Client Scripts (Theme, Lang Rewrite, Tabs, Copy) -->
    <script is:inline define:vars={{ slug, productHost, copiedText: t.copied }}>
      // 1. Theme toggle
      const themeToggle = document.getElementById('theme-toggle');
      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }

      // 2. Language link rewrite for previews / non-subdomain visits
      if (location.hostname !== productHost) {
        const esLink = document.querySelector('[data-lang-link="es"]');
        const enLink = document.querySelector('[data-lang-link="en"]');
        if (esLink) esLink.href = `/p/${slug}/`;
        if (enLink) enLink.href = `/p/${slug}/en/`;
      }

      // 3. Interactive Code Snippet Tabs
      const tabButtons = document.querySelectorAll('[data-snippet-tab]');
      const tabContents = document.querySelectorAll('[data-snippet-content]');
      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetIndex = btn.getAttribute('data-snippet-tab');
          tabButtons.forEach((b) => {
            b.classList.remove('bg-white/15', 'text-white', 'font-medium', 'shadow-sm');
            b.classList.add('text-slate-400');
          });
          btn.classList.add('bg-white/15', 'text-white', 'font-medium', 'shadow-sm');
          btn.classList.remove('text-slate-400');

          tabContents.forEach((c) => {
            if (c.getAttribute('data-snippet-content') === targetIndex) {
              c.classList.remove('hidden');
            } else {
              c.classList.add('hidden');
            }
          });
        });
      });

      // 4. Instant Copy Action with Visual Feedback
      const copyButtons = document.querySelectorAll('[data-copy-btn]');
      copyButtons.forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-copy-text');
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            const label = btn.querySelector('.copy-label');
            const originalText = label ? label.textContent : '';
            if (label) label.textContent = copiedText;
            btn.classList.add('bg-emerald-500/20', 'text-emerald-300');
            setTimeout(() => {
              if (label) label.textContent = originalText;
              btn.classList.remove('bg-emerald-500/20', 'text-emerald-300');
            }, 2000);
          } catch (err) {
            console.error('Failed to copy', err);
          }
        });
      });
    </script>
  </body>
</html>
