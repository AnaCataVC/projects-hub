---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allProjects = await getCollection('projects');
const serializedProjects = allProjects.map(p => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  icon: p.data.icon,
  githubUrl: p.data.githubUrl
}));
---

<Layout title="Ana-Catalina | Projects Hub">
    <div id="projects-data" data-projects={JSON.stringify(serializedProjects)} class="hidden"></div>
    <div id="main-wrapper" class="relative z-10 w-full flex-grow flex items-start sm:items-center justify-center pt-2 sm:pt-0 transition-all duration-500">
        
        <!-- Console Window -->
        <div id="console-window" class="flex w-full max-w-5xl bg-white/40 dark:bg-slate-900/40 backdrop-blur-xl border border-white/50 dark:border-slate-700/50 rounded-2xl shadow-2xl overflow-hidden animate-fade-in flex-col flex-grow transition-all duration-500">
            <!-- Window Header -->
            <div class="px-4 py-3 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between shrink-0 bg-white/50 dark:bg-slate-900/50">
                <div class="w-16 shrink-0 flex justify-start">
                    <img id="console-header-icon" src="/favicon.svg" alt="App Icon" class="w-5 h-5 opacity-80" />
                </div>
                <div class="flex-grow min-w-0 flex justify-center px-4">
                    <span id="header-path" class="text-xs sm:text-sm font-mono text-slate-500 truncate text-center w-full">~/projects-hub</span>
                </div>
                <div class="w-16 shrink-0 flex justify-end">
                    <!-- Empty div for layout symmetry -->
                </div>
            </div>

            <!-- Console Content Container -->
            <div class="p-4 sm:p-6 lg:p-8 flex-grow flex flex-col relative overflow-hidden">
                
                <!-- State 1: Interactive Tree Menu -->
                <div id="console-menu" class="flex-grow flex flex-col overflow-hidden">

                    <div id="menu-container" class="space-y-1 flex-grow outline-none font-['JetBrains_Mono',monospace] text-sm sm:text-base text-slate-700 dark:text-slate-300 overflow-y-auto pr-2" tabindex="0">
                        <!-- Renderizado por JS -->
                    </div>
                    
                    <!-- Simulated Command Line Prompt -->
                    <div class="shrink-0 px-3 py-2 mt-1 font-mono text-sm sm:text-base flex items-center text-slate-700 dark:text-slate-300 relative cursor-text overflow-hidden" onclick="document.getElementById('mobile-input').focus()">
                        <span class="text-indigo-600 dark:text-pastel-blue font-bold mr-2" id="prompt-symbol">❯</span>
                        <span id="search-query-text" class="whitespace-pre"></span>
                        <span class="inline-block w-2 h-4 sm:h-5 bg-slate-400 dark:bg-slate-500 animate-pulse-fast ml-0.5"></span>
                        
                        <!-- Invisible input to capture mobile keyboard natively -->
                        <input type="text" id="mobile-input" class="absolute inset-0 opacity-0 z-10 cursor-text w-full h-full" autocomplete="off" spellcheck="false" autocorrect="off" autocapitalize="none" />
                    </div>
                    
                    <div class="mt-4 pt-4 border-t border-slate-200/50 dark:border-slate-800/50 text-xs text-slate-400 dark:text-slate-500 hidden sm:flex no-touch flex-wrap gap-4 shrink-0">
                        <div class="flex items-center gap-1.5">
                            <span class="bg-slate-200 dark:bg-slate-700 px-1.5 rounded font-mono text-[9px] sm:text-[10px]">↑</span>
                            <span class="bg-slate-200 dark:bg-slate-700 px-1.5 rounded font-mono text-[9px] sm:text-[10px]">↓</span>
                            <span data-es="Navegar" data-en="Navigate">Navegar</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="bg-slate-200 dark:bg-slate-700 px-1.5 rounded font-mono text-[9px] sm:text-[10px]">↵</span>
                            <span data-es="Expandir/Ejecutar" data-en="Expand/Execute">Expandir/Ejecutar</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="bg-slate-200 dark:bg-slate-700 px-1.5 rounded font-mono text-[9px] sm:text-[10px]">←</span>
                            <span data-es="o" data-en="or">o</span>
                            <span class="bg-slate-200 dark:bg-slate-700 px-1.5 rounded font-mono text-[9px] sm:text-[10px]" data-es="Retroceso" data-en="Backspace">Retroceso</span>
                            <span data-es="Contraer" data-en="Collapse">Contraer</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        


    </div>

    <script>
        // Data Structure
        const menuData = [
            { 
                id: 'help', 
                title: '~/help', 
                desc: '# Ayuda y comandos', 
                color: 'text-pink-600 dark:text-pastel-pink',
                type: 'folder', 
                expanded: false, 
                children: [
                    { title: '<span class="no-touch">Usa las flechas [↑] y [↓] para navegar, y [Enter] o [→] para seleccionar o entrar a una carpeta.</span><span class="touch-only">Toca cualquier elemento de la lista para seleccionarlo o abrirlo.</span>', type: 'text' },
                    { title: '<span class="no-touch">Presiona [←] o [Retroceso] para regresar a la carpeta anterior.</span><span class="touch-only">Toca la opción ".." para regresar a la carpeta anterior.</span>', type: 'text' },
                    { title: '<span class="no-touch">Empieza a escribir en cualquier momento para buscar.</span><span class="touch-only">Toca la barra inferior para buscar.</span>', type: 'text' },
                    { title: '<span class="no-touch">Presiona [Esc] para limpiar la búsqueda actual, o regresar a la ruta principal.</span><span class="touch-only">Borra el texto para limpiar la búsqueda actual.</span>', type: 'text' }
                ]
            },
            {
                id: 'about',
                title: '~/about',
                desc: '# Sobre este hub',
                color: 'text-violet-600 dark:text-violet-400',
                type: 'folder',
                expanded: false,
                children: [
                    { title: '<span class="hidden sm:inline">¡Hola! Soy Ana-Catalina. Este espacio es mi directorio centralizado de desarrollo, diseñado como una interfaz de consola interactiva para explorar mi trabajo de forma rápida y de alto rendimiento.</span><span class="inline sm:hidden">¡Hola! Soy Ana-Catalina. Este es mi directorio de desarrollo personal (independiente de mi trabajo oficial).</span>', type: 'text' },
                    { title: '<span class="hidden sm:inline">Aquí recopilo mis proyectos personales independientes de mi trabajo oficial, desarrollados por diversión, como hobbie y por el deseo de seguir aprendiendo constantemente. Estos abarcan desde skills/agentes de IA y plantillas de código abierto, hasta aplicaciones analíticas completas.</span><span class="inline sm:hidden">Los desarrollo como hobbie para divertirme y aprender, abarcando desde agentes de IA hasta aplicaciones completas.</span>', type: 'text' },
                    { title: '<span class="hidden sm:block">Cada proyecto cuenta con una ficha técnica detallada (modo GUI) que documenta el problema de partida, las decisiones de arquitectura, el stack de tecnologías y los aprendizajes clave obtenidos.</span>', type: 'text' },
                    { title: ' ', type: 'text' },
                    { title: `© ${new Date().getFullYear()} Ana-Catalina.`, type: 'text' }
                ]
            },
            { 
                id: 'idioma', 
                title: '~/idioma', 
                desc: '# Cambiar idioma', 
                color: 'text-blue-600 dark:text-blue-400',
                type: 'folder', 
                expanded: false, 
                children: [
                    { title: '[es] Español', action: () => { 
                        if(window.setLanguageGlobal) window.setLanguageGlobal('es'); 
                        handleCollapse();
                    } },
                    { title: '[en] English', action: () => { 
                        if(window.setLanguageGlobal) window.setLanguageGlobal('en'); 
                        handleCollapse();
                    } }
                ]
            },
            { 
                id: 'tema', 
                title: '~/tema', 
                desc: '# Cambiar apariencia', 
                color: 'text-cyan-600 dark:text-cyan-400',
                type: 'folder', 
                expanded: false, 
                children: [
                    { title: '[☀] Claro', action: () => { 
                        if(window.setThemeGlobal) window.setThemeGlobal(false); 
                        localStorage.setItem('terminalThemeSet', 'true');
                        handleCollapse();
                    } },
                    { title: '[☾] Oscuro', action: () => { 
                        if(window.setThemeGlobal) window.setThemeGlobal(true); 
                        localStorage.setItem('terminalThemeSet', 'true');
                        handleCollapse();
                    } }
                ]
            },
            { 
                id: 'proyectos', 
                title: '~/proyectos', 
                desc: '# Explorar portfolio', 
                color: 'text-emerald-600 dark:text-pastel-mint',
                type: 'folder', 
                expanded: false, 
                children: [] // Populated dynamically
            }
        ];

        let currentPath = [];
        let flatList = [];
        let selectedIndex = 0;
        let searchQuery = '';
        const container = document.getElementById('menu-container');

        // Dynamic Projects
        const projectsDataEl = document.getElementById('projects-data');
        const rawProjects = projectsDataEl ? JSON.parse(projectsDataEl.dataset.projects || '[]') : [];
        const esProjects = rawProjects.filter(p => p.id.startsWith('es/')).map(p => ({...p, baseId: p.id.replace('es/', '')}));
        const enProjects = rawProjects.filter(p => p.id.startsWith('en/')).map(p => ({...p, baseId: p.id.replace('en/', '')}));

        function getProjectItems(lang) {
            const list = lang === 'es' ? esProjects : enProjects;
            return list.map(p => ({
                title: `⚡ ./${p.baseId}.sh`,
                type: 'action',
                color: 'text-indigo-600 dark:text-pastel-blue font-bold',
                action: () => window.launchProject(p.baseId, p.id)
            }));
        }

        window.launchProject = function(displayId, fullId) {
            const input = document.getElementById('mobile-input');
            if(input) input.blur();

            const textEl = document.getElementById('search-query-text');
            const promptSymbol = document.getElementById('prompt-symbol');
            
            searchQuery = '';
            selectedIndex = -1; 
            
            if (textEl && promptSymbol) {
                textEl.innerText = '';
                promptSymbol.innerText = '❯';
                promptSymbol.classList.replace('text-emerald-600', 'text-indigo-600');
                promptSymbol.classList.replace('dark:text-pastel-mint', 'dark:text-pastel-blue');
            }
            
            if(container) container.innerHTML = '';
            
            const cmd = `./launch ${displayId} --gui`;
            let i = 0;
            
            function typeChar() {
                if (i < cmd.length) {
                    textEl.innerText += cmd.charAt(i);
                    i++;
                    setTimeout(typeChar, 35);
                } else {
                    setTimeout(() => {
                        const win = document.getElementById('console-window');
                        if(win) win.classList.add('booting-up');
                        
                        setTimeout(() => {
                            const parts = fullId.split('/');
                            const targetPath = parts[0] === 'es' ? `/${parts[1]}` : `/${fullId}`;
                            window.location.href = targetPath;
                        }, 500); 
                    }, 250); 
                }
            }
            typeChar();
        };

        function updateSearchIndicator() {
            const textEl = document.getElementById('search-query-text');
            const promptSymbol = document.getElementById('prompt-symbol');
            if (!textEl || !promptSymbol) return;

            textEl.innerText = searchQuery;
            const mobileInput = document.getElementById('mobile-input');
            if (mobileInput && mobileInput.value !== searchQuery) {
                mobileInput.value = searchQuery;
            }
            
            // Change prompt symbol color when searching to make it obvious
            if (searchQuery.length > 0) {
                promptSymbol.classList.replace('text-indigo-600', 'text-emerald-600');
                promptSymbol.classList.replace('dark:text-pastel-blue', 'dark:text-pastel-mint');
                promptSymbol.innerText = 'find ❯';
            } else {
                promptSymbol.classList.replace('text-emerald-600', 'text-indigo-600');
                promptSymbol.classList.replace('dark:text-pastel-mint', 'dark:text-pastel-blue');
                promptSymbol.innerText = '❯';
            }
        }

        window.handleMenuClick = function(idx, e) {
            if (e) e.stopPropagation();
            selectedIndex = idx;
            handleAction();
        };

        window.handleMenuHover = function(idx, e) {
            // Ignore events on pure touch devices
            if (window.matchMedia && window.matchMedia('(hover: none)').matches) return;
            if (selectedIndex !== idx) {
                selectedIndex = idx;
                renderMenu(true);
            }
        };

        function renderMenu(skipAnimation = false) {
            flatList = [];
            if (!container) return;
            
            let nodesToRender = menuData;
            if (currentPath.length > 0) {
                const currentFolder = currentPath[currentPath.length - 1];
                nodesToRender = currentFolder.children || [];
                // Add back option ".."
                flatList.push({
                    title: '..',
                    desc: '',
                    type: 'action',
                    action: handleCollapse,
                    color: 'text-slate-500',
                    isBack: true
                });
            }

            if (searchQuery) {
                const query = searchQuery.toLowerCase();
                let searchResults = [];

                function searchNodes(nodes, currentLineage = []) {
                    const stripHtml = (str) => str.replace(/<[^>]*>?/gm, '');

                    nodes.forEach(node => {
                        const rawTitle = stripHtml(node.title);
                        const cleanTitle = rawTitle.replace('~/', '');
                        const matchTitle = cleanTitle.toLowerCase().includes(query);
                        const matchDesc = node.desc && node.desc.toLowerCase().includes(query);
                        
                        const matchChildText = node.children && node.children.some(child => 
                            child.type === 'text' && stripHtml(child.title).toLowerCase().includes(query)
                        );
                        
                        const newLineage = [...currentLineage, node];

                        // Skip 'text' nodes, we only want folders or actionable items in search results
                        if (node.type !== 'text') {
                            if (matchTitle || matchDesc || matchChildText) {
                                const pathHtml = currentLineage.map(n => {
                                    const nTitle = n.title.replace('~/', '').replace('[es] ', '').replace('[en] ', '').replace('[☀] ', '').replace('[☾] ', '');
                                    if (n.color) {
                                        return `<span class="${n.color}">${nTitle}</span>`;
                                    }
                                    return nTitle;
                                }).join(' <span class="opacity-50">/</span> ');
                                
                                searchResults.push({
                                    ...node,
                                    searchTitle: pathHtml ? `${pathHtml} <span class="opacity-50">/</span> ${cleanTitle}` : cleanTitle,
                                    lineage: newLineage
                                });
                            }
                        }
                        
                        if (node.children) {
                            searchNodes(node.children, newLineage);
                        }
                    });
                }
                
                searchNodes(menuData);
                nodesToRender = searchResults;
            }

            nodesToRender.forEach(node => flatList.push(node));
            
            // Ensure selectedIndex is within bounds
            if (selectedIndex >= flatList.length) selectedIndex = flatList.length - 1;
            if (selectedIndex < 0) selectedIndex = 0;

            let html = '';
            flatList.forEach((item, idx) => {
                const isSelected = idx === selectedIndex;
                const isSelectable = item.type !== 'text';
                
                const bgClass = isSelected && isSelectable ? 'bg-slate-200/50 dark:bg-slate-800/50' : (isSelectable ? 'hover:bg-slate-100/30 dark:hover:bg-slate-800/30 cursor-pointer' : '');
                const textColor = item.color || 'text-slate-700 dark:text-slate-300';
                const opacityClass = item.type === 'text' ? 'opacity-70 italic' : '';
                
                const animClass = skipAnimation ? '' : 'menu-item-anim';
                const animStyle = skipAnimation ? '' : `style="animation-delay: ${idx * 30}ms;"`;
                
                let icon = '';
                if (item.type === 'folder') {
                    icon = '▶ ';
                } else if (item.isBack) {
                    icon = '↵ ';
                }

                let displayTitle = item.searchTitle || item.title;

                if (isSelected && isSelectable) {
                    if (icon) {
                        icon = `<span class="animate-pulse-fast">${icon.trim()}</span> `;
                    } else {
                        // For actions that have their icon baked into the title
                        displayTitle = displayTitle.replace(/(↳|\[☀\]|\[☾\]|⚡)/, '<span class="animate-pulse-fast">$1</span>');
                    }
                }

                if (item.type === 'text') {
                    html += `
                        <div 
                            class="flex px-3 py-1.5 sm:py-1 rounded transition-colors ${animClass} ${bgClass}"
                            ${animStyle}
                        >
                            <div class="flex-grow flex items-start">
                                <span class="${textColor} font-medium ${opacityClass} whitespace-normal leading-relaxed break-words pr-2">${icon}${displayTitle}</span>
                                ${item.desc ? `<span class="ml-3 text-slate-400 dark:text-slate-500 text-xs sm:text-sm hidden sm:inline shrink-0 mt-0.5">${item.desc}</span>` : ''}
                            </div>
                        </div>
                    `;
                } else {
                    html += `
                        <button type="button" data-idx="${idx}"
                            class="w-full text-left flex items-center px-3 py-4 sm:py-2 rounded transition-colors ${animClass} ${bgClass}"
                            ${animStyle}
                            onclick="window.handleMenuClick(${idx}, event)"
                            onmousemove="window.handleMenuHover(${idx}, event)"
                        >
                            <div class="flex-grow flex items-baseline pointer-events-none">
                                <span class="${textColor} font-medium ${opacityClass}">${icon}${displayTitle}</span>
                                ${item.desc ? `<span class="ml-3 text-slate-400 dark:text-slate-500 text-xs sm:text-sm hidden sm:inline">${item.desc}</span>` : ''}
                            </div>
                        </button>
                    `;
                }
            });
            container.innerHTML = html;

            // Update Header Path
            const headerPathEl = document.getElementById('header-path');
            if (headerPathEl) {
                if (currentPath.length === 0) {
                    headerPathEl.innerText = '~/projects-hub';
                } else {
                    const pathStr = currentPath.map(p => p.id || p.title.replace('~/', '')).join('/');
                    headerPathEl.innerText = `~/projects-hub/${pathStr}`;
                }
            }

            const headerIconEl = document.getElementById('console-header-icon');
            if (headerIconEl) {
                if (currentPath.length > 0 && currentPath[currentPath.length - 1].icon) {
                    headerIconEl.src = currentPath[currentPath.length - 1].icon;
                } else {
                    headerIconEl.src = '/favicon.svg';
                }
            }

            const selectedEl = container.querySelector(`[data-idx="${selectedIndex}"]`);
            if (selectedEl) {
                selectedEl.scrollIntoView({ block: 'nearest' });
            }
        }

        function handleAction() {
            const item = flatList[selectedIndex];
            if (!item) return;

            if (item.type === 'folder') {
                if (item.lineage) {
                    currentPath = [...item.lineage];
                } else {
                    currentPath.push(item);
                }
                searchQuery = '';
                updateSearchIndicator();
                selectedIndex = 0;
                renderMenu();
            } else if (item.action) {
                item.action();
                searchQuery = '';
                updateSearchIndicator();
                renderMenu();
            }
        }
        
        function handleCollapse() {
            if (currentPath.length > 0) {
                currentPath.pop();
                searchQuery = '';
                updateSearchIndicator();
                selectedIndex = 0;
                renderMenu();
            }
        }

        window.updateUIText = function(lang) {
            document.querySelectorAll('[data-es]').forEach(el => {
                if (lang === 'es' && el.dataset.es) el.innerHTML = el.dataset.es;
                if (lang === 'en' && el.dataset.en) el.innerHTML = el.dataset.en;
            });

            if (lang === 'en') {
                menuData[0].desc = '# Help and commands';
                menuData[0].children[0].title = '<span class="no-touch">Use arrows [↑] and [↓] to navigate, and [Enter] or [→] to select or enter a folder.</span><span class="touch-only">Tap any item in the list to select or open it.</span>';
                menuData[0].children[1].title = '<span class="no-touch">Press [←] or [Backspace] to go back to the previous folder.</span><span class="touch-only">Tap the ".." option to go back to the previous folder.</span>';
                menuData[0].children[2].title = '<span class="no-touch">Start typing at any time to search.</span><span class="touch-only">Tap the bottom bar to search.</span>';
                menuData[0].children[3].title = '<span class="no-touch">Press [Esc] to clear the current search, or return to the root path.</span><span class="touch-only">Delete the text to clear the current search.</span>';

                menuData[1].desc = '# About this hub';
                menuData[1].children[0].title = '<span class="hidden sm:inline">Hi! I\'m Ana-Catalina. This space is my centralized development directory, designed as an interactive console interface to explore my work in a fast, high-performance environment.</span><span class="inline sm:hidden">Hi! I\'m Ana-Catalina. This is my personal development directory (independent of my official work).</span>';
                menuData[1].children[1].title = '<span class="hidden sm:inline">Here I gather my personal projects, which are independent of my official work and developed as a hobby, for learning, and just for fun. These range from AI skills/agents and open-source templates to full analytical applications.</span><span class="inline sm:hidden">I build them as a hobby to learn and have fun, ranging from AI agents to full web applications.</span>';
                menuData[1].children[2].title = '<span class="hidden sm:block">Each project features a detailed case study (GUI mode) documenting the initial problem, architectural decisions, technology stack, and key technical learnings.</span>';
                menuData[1].children[3].title = ' ';
                menuData[1].children[4].title = `© ${new Date().getFullYear()} Ana-Catalina.`;

                menuData[2].title = '~/language';
                menuData[2].desc = '# Change language';
                
                menuData[3].title = '~/theme';
                menuData[3].desc = '# Change theme';
                menuData[3].children[0].title = '↳ Light mode';
                menuData[3].children[1].title = '↳ Dark mode';

                menuData[4].title = '~/projects';
                menuData[4].desc = '# Web development';
                menuData[4].children = getProjectItems('en');
            } else {
                menuData[0].desc = '# Ayuda y comandos';
                menuData[0].children[0].title = '<span class="no-touch">Usa las flechas [↑] y [↓] para navegar, y [Enter] o [→] para seleccionar o entrar a una carpeta.</span><span class="touch-only">Toca cualquier elemento de la lista para seleccionarlo o abrirlo.</span>';
                menuData[0].children[1].title = '<span class="no-touch">Presiona [←] o [Retroceso] para regresar a la carpeta anterior.</span><span class="touch-only">Toca la opción ".." para regresar a la carpeta anterior.</span>';
                menuData[0].children[2].title = '<span class="no-touch">Empieza a escribir en cualquier momento para buscar.</span><span class="touch-only">Toca la barra inferior para buscar.</span>';
                menuData[0].children[3].title = '<span class="no-touch">Presiona [Esc] para limpiar la búsqueda actual, o regresar a la ruta principal.</span><span class="touch-only">Borra el texto para limpiar la búsqueda actual.</span>';

                menuData[1].desc = '# Sobre este hub';
                menuData[1].children[0].title = '<span class="hidden sm:inline">¡Hola! Soy Ana-Catalina. Este espacio es mi directorio centralizado de desarrollo, diseñado como una interfaz de consola interactiva para explorar mi trabajo de forma rápida y de alto rendimiento.</span><span class="inline sm:hidden">¡Hola! Soy Ana-Catalina. Este es mi directorio de desarrollo personal (independiente de mi trabajo oficial).</span>';
                menuData[1].children[1].title = '<span class="hidden sm:inline">Aquí recopilo mis proyectos personales independientes de mi trabajo oficial, desarrollados por diversión, como hobbie y por el deseo de seguir aprendiendo constantemente. Estos abarcan desde skills/agentes de IA y plantillas de código abierto, hasta aplicaciones analíticas completas.</span><span class="inline sm:hidden">Los desarrollo como hobbie para divertirme y aprender, abarcando desde agentes de IA hasta aplicaciones completas.</span>';
                menuData[1].children[2].title = '<span class="hidden sm:block">Cada proyecto cuenta con una ficha técnica detallada (modo GUI) que documenta el problema de partida, las decisiones de arquitectura, el stack de tecnologías y los aprendizajes clave obtenidos.</span>';
                menuData[1].children[3].title = ' ';
                menuData[1].children[4].title = `© ${new Date().getFullYear()} Ana-Catalina.`;

                menuData[2].title = '~/idioma';
                menuData[2].desc = '# Cambiar idioma';
                
                menuData[3].title = '~/tema';
                menuData[3].desc = '# Cambiar apariencia';
                menuData[3].children[0].title = '[☀] Claro';
                menuData[3].children[1].title = '[☾] Oscuro';

                menuData[4].title = '~/proyectos';
                menuData[4].desc = '# Explorar portfolio';
                menuData[4].children = getProjectItems('es');
            }

            renderMenu();
        };

        // Force translation on initial load to avoid race conditions with DOMContentLoaded
        if (typeof localStorage !== 'undefined') {
            const currentLang = localStorage.getItem('lang') || 'es';
            window.updateUIText(currentLang);
        }

        // Mobile input native sync
        document.getElementById('mobile-input')?.addEventListener('input', (e) => {
            searchQuery = e.target.value;
            updateSearchIndicator();
            selectedIndex = 0;
            renderMenu();
        });

        // Keyboard events
        window.addEventListener('keydown', (e) => {
            const menuVisible = !document.getElementById('console-menu')?.classList.contains('hidden');
            
            if (!menuVisible) {
                if (e.key === 'Escape') {
                    e.preventDefault();
                    location.reload();
                }
                return;
            }

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                let nextIdx = selectedIndex;
                while (nextIdx < flatList.length - 1) {
                    nextIdx++;
                    if (flatList[nextIdx].type !== 'text') {
                        selectedIndex = nextIdx;
                        break;
                    }
                }
                renderMenu(true);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                let prevIdx = selectedIndex;
                while (prevIdx > 0) {
                    prevIdx--;
                    if (flatList[prevIdx].type !== 'text') {
                        selectedIndex = prevIdx;
                        break;
                    }
                }
                renderMenu(true);
            } else if (e.key === 'Enter' || e.key === 'ArrowRight') {
                e.preventDefault();
                handleAction();
            } else if (e.key === 'Backspace') {
                if (searchQuery.length > 0) {
                    searchQuery = searchQuery.slice(0, -1);
                    selectedIndex = 0;
                    updateSearchIndicator();
                    renderMenu();
                } else {
                    e.preventDefault();
                    if (currentPath.length > 0) {
                        handleCollapse();
                    }
                }
            } else if (e.key === 'Escape') {
                e.preventDefault();
                if (searchQuery.length > 0) {
                    searchQuery = '';
                    selectedIndex = 0;
                    updateSearchIndicator();
                    renderMenu();
                } else {
                    location.reload();
                }
            } else if (e.key === 'ArrowLeft') {
                e.preventDefault();
                if (searchQuery.length > 0) {
                    searchQuery = '';
                    updateSearchIndicator();
                }
                if (currentPath.length > 0) {
                    handleCollapse();
                }
            } else if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
                // Ignore space bar if we're not searching, otherwise scrolling happens
                if (e.key === ' ' && searchQuery.length === 0) return;
                
                searchQuery += e.key;
                selectedIndex = 0;
                updateSearchIndicator();
                renderMenu();
            }
        });

        // Initialize App
        document.getElementById('menu-container')?.focus();
        
        // Hide global language button (terminal has its own)
        document.getElementById('global-actions')?.classList.add('hidden');
        document.body.classList.add('terminal-active');

        // Handle bfcache (back button)
        window.addEventListener('pageshow', (event) => {
            if (event.persisted) {
                const win = document.getElementById('console-window');
                if (win) win.classList.remove('booting-up');
                
                searchQuery = '';
                const textEl = document.getElementById('search-query-text');
                const promptSymbol = document.getElementById('prompt-symbol');
                const mobileInput = document.getElementById('mobile-input');
                
                if (textEl) textEl.innerText = '';
                if (mobileInput) mobileInput.value = '';
                if (promptSymbol) {
                    promptSymbol.innerText = '❯';
                    promptSymbol.classList.remove('text-emerald-600', 'dark:text-pastel-mint');
                    promptSymbol.classList.add('text-indigo-600', 'dark:text-pastel-blue');
                }
                
                selectedIndex = 0;
                renderMenu(true);
            }
        });

        // Initial render
        renderMenu();
    </script>

    <style is:global>
        @keyframes menuSlide {
            from { opacity: 0; transform: translateY(-4px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .menu-item-anim {
            animation: menuSlide 0.2s ease-out forwards;
            opacity: 0;
        }

        @keyframes pulseFast {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }
        .animate-pulse-fast {
            animation: pulseFast 1s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        body.terminal-active {
            overflow: hidden;
        }
        body.terminal-active #global-logo,
        body.terminal-active #global-footer {
            display: none !important;
        }
        body.terminal-active #main-content {
            margin-top: 1rem !important;
            margin-bottom: 1rem !important;
            padding-top: 0 !important;
            padding-bottom: 0 !important;
            height: calc(100vh - 2rem);
            max-height: calc(100vh - 2rem);
            height: calc(100dvh - 2rem);
            max-height: calc(100dvh - 2rem);
        }
        @media (min-width: 640px) {
            body.terminal-active #main-content {
                margin-top: 2rem !important;
                margin-bottom: 2rem !important;
                height: calc(100vh - 4rem);
                max-height: calc(100vh - 4rem);
                height: calc(100dvh - 4rem);
                max-height: calc(100dvh - 4rem);
            }
        }

        .booting-up {
            transform: scale(1.15) translateY(-10px);
            opacity: 0;
            filter: blur(12px);
            pointer-events: none;
        }
    </style>
</Layout>
