---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ana-Catalina | Projects Hub">
    <div id="main-wrapper" class="relative z-10 w-full flex-grow flex items-center justify-center transition-all duration-500">
        

        <!-- Console Window -->
        <div id="console-window" class="flex w-full max-w-4xl bg-white/40 dark:bg-slate-900/40 backdrop-blur-xl border border-white/50 dark:border-slate-700/50 rounded-2xl shadow-2xl overflow-hidden animate-fade-in flex-col flex-grow">
            <!-- Window Header -->
            <div class="px-4 py-3 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between shrink-0 bg-white/50 dark:bg-slate-900/50">
                <div class="w-16 shrink-0 flex justify-start">
                    <img id="console-header-icon" src="/favicon.svg" alt="App Icon" class="w-5 h-5 opacity-80" />
                </div>
                <div class="flex-grow min-w-0 flex justify-center px-4">
                    <span id="header-path" class="text-xs sm:text-sm font-mono text-slate-500 truncate text-center w-full">~/projects-hub</span>
                </div>
                <div class="w-16 shrink-0 flex justify-end">
                    <!-- Empty div for layout symmetry -->
                </div>
            </div>

            <!-- Console Content Container -->
            <div class="p-4 sm:p-6 lg:p-8 flex-grow flex flex-col relative overflow-hidden">
                
                <!-- State 1: Interactive Tree Menu -->
                <div id="console-menu" class="flex-grow flex flex-col overflow-hidden">

                    <div id="menu-container" class="space-y-1 flex-grow outline-none font-['JetBrains_Mono',monospace] text-sm sm:text-base text-slate-700 dark:text-slate-300 overflow-y-auto pr-2" tabindex="0">
                        <!-- Renderizado por JS -->
                    </div>
                    
                    <!-- Simulated Command Line Prompt -->
                    <div class="shrink-0 px-3 py-2 mt-1 font-mono text-sm sm:text-base flex items-center text-slate-700 dark:text-slate-300">
                        <span class="text-indigo-600 dark:text-indigo-400 font-bold mr-2" id="prompt-symbol">❯</span>
                        <span id="search-query-text" class="whitespace-pre"></span>
                        <span class="inline-block w-2 h-4 sm:h-5 bg-slate-400 dark:bg-slate-500 animate-pulse-fast ml-0.5"></span>
                    </div></div>
                    
                    <div class="mt-4 pt-4 border-t border-slate-200/50 dark:border-slate-800/50 text-xs text-slate-400 dark:text-slate-500 hidden sm:flex flex-wrap gap-4 shrink-0">
                        <div class="flex items-center gap-1.5">
                            <span class="bg-slate-200 dark:bg-slate-700 px-1.5 rounded font-mono text-[9px] sm:text-[10px]">↑</span>
                            <span class="bg-slate-200 dark:bg-slate-700 px-1.5 rounded font-mono text-[9px] sm:text-[10px]">↓</span>
                            <span data-es="Navegar" data-en="Navigate">Navegar</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="bg-slate-200 dark:bg-slate-700 px-1.5 rounded font-mono text-[9px] sm:text-[10px]">↵</span>
                            <span data-es="Expandir/Ejecutar" data-en="Expand/Execute">Expandir/Ejecutar</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="bg-slate-200 dark:bg-slate-700 px-1.5 rounded font-mono text-[9px] sm:text-[10px]">←</span>
                            <span data-es="o" data-en="or">o</span>
                            <span class="bg-slate-200 dark:bg-slate-700 px-1.5 rounded font-mono text-[9px] sm:text-[10px]" data-es="Retroceso" data-en="Backspace">Retroceso</span>
                            <span data-es="Contraer" data-en="Collapse">Contraer</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        


    </div>

    <script>
        // Data Structure
        const menuData = [
            { 
                id: 'help', 
                title: '~/help', 
                desc: '# Ayuda y comandos', 
                color: 'text-amber-600 dark:text-amber-400',
                type: 'folder', 
                expanded: false, 
                children: [
                    { title: 'Usa las flechas [↑] y [↓] para navegar, y [Enter] o [→] para seleccionar o entrar a una carpeta.', type: 'text' },
                    { title: 'Presiona [←] o [Retroceso] para regresar a la carpeta anterior.', type: 'text' },
                    { title: 'Empieza a escribir en cualquier momento para buscar.', type: 'text' },
                    { title: 'Presiona [Esc] para limpiar la búsqueda actual, o regresar a la ruta principal.', type: 'text' }
                ]
            },
            {
                id: 'about',
                title: '~/about',
                desc: '# Sobre este hub',
                color: 'text-orange-600 dark:text-orange-400',
                type: 'folder',
                expanded: false,
                children: [
                    { title: 'Proyectos personales desarrollados para explorar, aprender y compartir con la comunidad.', type: 'text' },
                    { title: ' ', type: 'text' },
                    { title: `© ${new Date().getFullYear()} Ana-Catalina.`, type: 'text' }
                ]
            },
            {
                id: 'links',
                title: '~/links',
                desc: '# Contacto y redes',
                color: 'text-pink-600 dark:text-pink-400',
                type: 'folder',
                expanded: false,
                children: [
                    { title: '↳ ana-catalina.com', type: 'action', action: () => window.location.href = 'https://ana-catalina.com' },
                    { title: '↳ LinkedIn', type: 'action', action: () => window.open('https://linkedin.com/in/ana-catalina/', '_blank') },
                    { title: '↳ GitHub', type: 'action', action: () => window.open('https://github.com/AnaCataVC/', '_blank') }
                ]
            },
            { 
                id: 'idioma', 
                title: '~/idioma', 
                desc: '# Cambiar idioma', 
                color: 'text-purple-600 dark:text-purple-400',
                type: 'folder', 
                expanded: false, 
                children: [
                    { title: '[es] Español', action: () => { 
                        if(window.setLanguageGlobal) window.setLanguageGlobal('es'); 
                        handleCollapse();
                    } },
                    { title: '[en] English', action: () => { 
                        if(window.setLanguageGlobal) window.setLanguageGlobal('en'); 
                        handleCollapse();
                    } }
                ]
            },
            { 
                id: 'tema', 
                title: '~/tema', 
                desc: '# Cambiar apariencia', 
                color: 'text-blue-600 dark:text-blue-400',
                type: 'folder', 
                expanded: false, 
                children: [
                    { title: '[☀] Claro', action: () => { 
                        if(window.setThemeGlobal) window.setThemeGlobal(false); 
                        localStorage.setItem('terminalThemeSet', 'true');
                        handleCollapse();
                    } },
                    { title: '[☾] Oscuro', action: () => { 
                        if(window.setThemeGlobal) window.setThemeGlobal(true); 
                        localStorage.setItem('terminalThemeSet', 'true');
                        handleCollapse();
                    } }
                ]
            },
            { 
                id: 'proyectos', 
                title: '~/proyectos', 
                desc: '# Explorar portfolio', 
                color: 'text-emerald-600 dark:text-emerald-400',
                type: 'folder', 
                expanded: false, 
                children: [
                    { 
                        title: 'Life Tracker Analytics', 
                        type: 'folder', 
                        icon: '/project-icons/lta_icon.png',
                        expanded: false, 
                        children: [
                            { title: '▪ Aplicación web para rastrear y analizar métricas de vida y hábitos diarios mediante visualizaciones de datos.', type: 'text' },
                            { title: '↳ Ver app', action: () => window.location.href = '/life-tracker-analytics/' },
                            { title: '↳ Ver en GitHub', action: () => window.open('https://github.com/AnaCataVC/life-tracker-analytics', '_blank') }
                        ]
                    },
                    { 
                        title: 'Amiga IA', 
                        type: 'folder', 
                        icon: '/project-icons/ami-icon.png',
                        expanded: false, 
                        children: [
                            { title: '▪ Repositorio centralizado de habilidades y agentes para asistentes IA. Facilita la programación y asegura la calidad del código.', type: 'text' },
                            { title: '↳ Ver página de producto', action: () => window.location.href = '/amiga-ia/' },
                            { title: '↳ Ver en GitHub', action: () => window.open('https://github.com/AnaCataVC/amiga-ia', '_blank') }
                        ]
                    },
                    { 
                        title: 'My CV Template', 
                        type: 'folder', 
                        icon: '/project-icons/cv-icon.svg',
                        expanded: false, 
                        children: [
                            { title: '▪ Plantilla moderna e interactiva para construir tu propio currículum o portafolio profesional. Fácil de configurar y desplegar.', type: 'text' },
                            { title: '↳ Ver demo interactiva', type: 'action', action: () => window.location.href = '/my-cv/' },
                            { title: '↳ Ver en GitHub', type: 'action', action: () => window.open('https://github.com/AnaCataVC/my-cv', '_blank') }
                        ]
                    },
                    { 
                        title: 'Identity Map', 
                        type: 'folder', 
                        icon: '/project-icons/identitymap_icon.png',
                        expanded: false, 
                        children: [
                            { title: '▪ Aplicación web interactiva para visualizar y explorar mapas de identidad.', type: 'text' },
                            { title: '↳ Ver app', type: 'action', action: () => window.location.href = '/identity-map/' },
                            { title: '↳ Ver en GitHub', type: 'action', action: () => window.open('https://github.com/AnaCataVC/identity-map', '_blank') }
                        ]
                    }
                ]
            }
        ];

        let currentPath = [];
        let flatList = [];
        let selectedIndex = 0;
        let searchQuery = '';
        const container = document.getElementById('menu-container');

        function updateSearchIndicator() {
            const textEl = document.getElementById('search-query-text');
            const promptSymbol = document.getElementById('prompt-symbol');
            if (!textEl || !promptSymbol) return;

            textEl.innerText = searchQuery;
            
            // Change prompt symbol color when searching to make it obvious
            if (searchQuery.length > 0) {
                promptSymbol.classList.replace('text-indigo-600', 'text-emerald-500');
                promptSymbol.classList.replace('dark:text-indigo-400', 'dark:text-emerald-400');
                promptSymbol.innerText = 'find ❯';
            } else {
                promptSymbol.classList.replace('text-emerald-500', 'text-indigo-600');
                promptSymbol.classList.replace('dark:text-emerald-400', 'dark:text-indigo-400');
                promptSymbol.innerText = '❯';
            }
        }

        window.handleMenuClick = function(idx, e) {
            if (e) e.stopPropagation();
            selectedIndex = idx;
            handleAction();
        };

        window.handleMenuHover = function(idx, e) {
            // Ignore events on pure touch devices
            if (window.matchMedia && window.matchMedia('(hover: none)').matches) return;
            if (selectedIndex !== idx) {
                selectedIndex = idx;
                renderMenu(true);
            }
        };

        function renderMenu(skipAnimation = false) {
            flatList = [];
            if (!container) return;
            
            let nodesToRender = menuData;
            if (currentPath.length > 0) {
                const currentFolder = currentPath[currentPath.length - 1];
                nodesToRender = currentFolder.children || [];
                // Add back option ".."
                flatList.push({
                    title: '..',
                    desc: '',
                    type: 'action',
                    action: handleCollapse,
                    color: 'text-slate-500',
                    isBack: true
                });
            }

            if (searchQuery) {
                const query = searchQuery.toLowerCase();
                let searchResults = [];

                function searchNodes(nodes, currentLineage = []) {
                    nodes.forEach(node => {
                        const cleanTitle = node.title.replace('~/', '');
                        const matchTitle = cleanTitle.toLowerCase().includes(query);
                        const matchDesc = node.desc && node.desc.toLowerCase().includes(query);
                        
                        const matchChildText = node.children && node.children.some(child => 
                            child.type === 'text' && child.title.toLowerCase().includes(query)
                        );
                        
                        const newLineage = [...currentLineage, node];

                        // Skip 'text' nodes, we only want folders or actionable items in search results
                        if (node.type !== 'text') {
                            if (matchTitle || matchDesc || matchChildText) {
                                const pathHtml = currentLineage.map(n => {
                                    const nTitle = n.title.replace('~/', '').replace('[es] ', '').replace('[en] ', '').replace('[☀] ', '').replace('[☾] ', '');
                                    if (n.color) {
                                        return `<span class="${n.color}">${nTitle}</span>`;
                                    }
                                    return nTitle;
                                }).join(' <span class="opacity-50">/</span> ');
                                
                                searchResults.push({
                                    ...node,
                                    searchTitle: pathHtml ? `${pathHtml} <span class="opacity-50">/</span> ${cleanTitle}` : cleanTitle,
                                    lineage: newLineage
                                });
                            }
                        }
                        
                        if (node.children) {
                            searchNodes(node.children, newLineage);
                        }
                    });
                }
                
                searchNodes(menuData);
                nodesToRender = searchResults;
            }

            nodesToRender.forEach(node => flatList.push(node));
            
            // Ensure selectedIndex is within bounds
            if (selectedIndex >= flatList.length) selectedIndex = flatList.length - 1;
            if (selectedIndex < 0) selectedIndex = 0;

            let html = '';
            flatList.forEach((item, idx) => {
                const isSelected = idx === selectedIndex;
                const isSelectable = item.type !== 'text';
                
                const bgClass = isSelected && isSelectable ? 'bg-slate-200/50 dark:bg-slate-800/50' : (isSelectable ? 'hover:bg-slate-100/30 dark:hover:bg-slate-800/30 cursor-pointer' : '');
                const textColor = item.color || 'text-slate-700 dark:text-slate-300';
                const opacityClass = item.type === 'text' ? 'opacity-70 italic' : '';
                
                const animClass = skipAnimation ? '' : 'menu-item-anim';
                const animStyle = skipAnimation ? '' : `style="animation-delay: ${idx * 30}ms;"`;
                
                let icon = '';
                if (item.type === 'folder') {
                    icon = '▶ ';
                } else if (item.isBack) {
                    icon = '↵ ';
                }

                let displayTitle = item.searchTitle || item.title;

                if (isSelected && isSelectable) {
                    if (icon) {
                        icon = `<span class="animate-pulse-fast">${icon.trim()}</span> `;
                    } else {
                        // For actions that have their icon baked into the title
                        displayTitle = displayTitle.replace(/(↳|\[☀\]|\[☾\])/, '<span class="animate-pulse-fast">$1</span>');
                    }
                }

                if (item.type === 'text') {
                    html += `
                        <div 
                            class="flex px-3 py-1.5 sm:py-1 rounded transition-colors ${animClass} ${bgClass}"
                            ${animStyle}
                        >
                            <div class="flex-grow flex items-start">
                                <span class="${textColor} font-medium ${opacityClass} whitespace-normal leading-relaxed break-words pr-2">${icon}${displayTitle}</span>
                                ${item.desc ? `<span class="ml-3 text-slate-400 dark:text-slate-500 text-xs sm:text-sm hidden sm:inline shrink-0 mt-0.5">${item.desc}</span>` : ''}
                            </div>
                        </div>
                    `;
                } else {
                    html += `
                        <button type="button" data-idx="${idx}"
                            class="w-full text-left flex items-center px-3 py-4 sm:py-2 rounded transition-colors ${animClass} ${bgClass}"
                            ${animStyle}
                            onclick="window.handleMenuClick(${idx}, event)"
                            onmousemove="window.handleMenuHover(${idx}, event)"
                        >
                            <div class="flex-grow flex items-baseline pointer-events-none">
                                <span class="${textColor} font-medium ${opacityClass}">${icon}${displayTitle}</span>
                                ${item.desc ? `<span class="ml-3 text-slate-400 dark:text-slate-500 text-xs sm:text-sm hidden sm:inline">${item.desc}</span>` : ''}
                            </div>
                        </button>
                    `;
                }
            });
            container.innerHTML = html;

            // Update Header Path
            const headerPathEl = document.getElementById('header-path');
            if (headerPathEl) {
                if (currentPath.length === 0) {
                    headerPathEl.innerText = '~/projects-hub';
                } else {
                    const pathStr = currentPath.map(p => p.id || p.title.replace('~/', '')).join('/');
                    headerPathEl.innerText = `~/projects-hub/${pathStr}`;
                }
            }

            const headerIconEl = document.getElementById('console-header-icon');
            if (headerIconEl) {
                if (currentPath.length > 0 && currentPath[currentPath.length - 1].icon) {
                    headerIconEl.src = currentPath[currentPath.length - 1].icon;
                } else {
                    headerIconEl.src = '/favicon.svg';
                }
            }

            const selectedEl = container.querySelector(`[data-idx="${selectedIndex}"]`);
            if (selectedEl) {
                selectedEl.scrollIntoView({ block: 'nearest' });
            }
        }

        function handleAction() {
            const item = flatList[selectedIndex];
            if (!item) return;

            if (item.type === 'folder') {
                if (item.lineage) {
                    currentPath = [...item.lineage];
                } else {
                    currentPath.push(item);
                }
                searchQuery = '';
                updateSearchIndicator();
                selectedIndex = 0;
                renderMenu();
            } else if (item.action) {
                item.action();
                searchQuery = '';
                updateSearchIndicator();
                renderMenu();
            }
        }
        
        function handleCollapse() {
            if (currentPath.length > 0) {
                currentPath.pop();
                searchQuery = '';
                updateSearchIndicator();
                selectedIndex = 0;
                renderMenu();
            }
        }

        window.updateUIText = function(lang) {
            document.querySelectorAll('[data-es]').forEach(el => {
                if (lang === 'es' && el.dataset.es) el.innerHTML = el.dataset.es;
                if (lang === 'en' && el.dataset.en) el.innerHTML = el.dataset.en;
            });

            if (lang === 'en') {
                menuData[0].desc = '# Help and commands';
                menuData[0].children[0].title = 'Use arrows [↑] and [↓] to navigate, and [Enter] or [→] to select or enter a folder.';
                menuData[0].children[1].title = 'Press [←] or [Backspace] to go back to the previous folder.';
                menuData[0].children[2].title = 'Start typing at any time to search.';
                menuData[0].children[3].title = 'Press [Esc] to clear the current search, or return to the root path.';

                menuData[1].desc = '# About this hub';
                menuData[1].children[0].title = 'Personal projects developed to explore, learn and share with the community.';
                menuData[1].children[1].title = ' ';
                menuData[1].children[2].title = `© ${new Date().getFullYear()} Ana-Catalina.`;

                menuData[2].desc = '# Contact and links';

                menuData[3].title = '~/language';
                menuData[3].desc = '# Change language';
                
                menuData[4].title = '~/theme';
                menuData[4].desc = '# Change theme';
                menuData[4].children[0].title = '↳ Light mode';
                menuData[4].children[1].title = '↳ Dark mode';

                menuData[5].title = '~/projects';
                menuData[5].desc = '# Web development';
                
                menuData[5].children[0].children[0].title = '▪ Web application to track and analyze life metrics and daily habits through data visualizations.';
                menuData[5].children[0].children[1].title = '↳ View app';
                menuData[5].children[0].children[2].title = '↳ View on GitHub';

                menuData[5].children[1].children[0].title = '▪ Centralized repository of skills and agents for AI assistants. It makes programming easier and ensures code quality.';
                menuData[5].children[1].children[1].title = '↳ View product page';
                menuData[5].children[1].children[2].title = '↳ View on GitHub';

                menuData[5].children[2].children[0].title = '▪ A modern and interactive template to build your own resume or professional portfolio. Easy to configure and deploy.';
                menuData[5].children[2].children[1].title = '↳ View interactive demo';
                menuData[5].children[2].children[2].title = '↳ View on GitHub';

                menuData[5].children[3].children[0].title = '▪ Interactive web application to visualize and explore identity maps.';
                menuData[5].children[3].children[1].title = '↳ View app';
                menuData[5].children[3].children[2].title = '↳ View on GitHub';
            } else {
                menuData[0].desc = '# Ayuda y comandos';
                menuData[0].children[0].title = 'Usa las flechas [↑] y [↓] para navegar, y [Enter] o [→] para seleccionar o entrar a una carpeta.';
                menuData[0].children[1].title = 'Presiona [←] o [Retroceso] para regresar a la carpeta anterior.';
                menuData[0].children[2].title = 'Empieza a escribir en cualquier momento para buscar.';
                menuData[0].children[3].title = 'Presiona [Esc] para limpiar la búsqueda actual, o regresar a la ruta principal.';

                menuData[1].desc = '# Sobre este hub';
                menuData[1].children[0].title = 'Proyectos personales desarrollados para explorar, aprender y compartir con la comunidad.';
                menuData[1].children[1].title = ' ';
                menuData[1].children[2].title = `© ${new Date().getFullYear()} Ana-Catalina.`;

                menuData[2].desc = '# Contacto y redes';

                menuData[3].title = '~/idioma';
                menuData[3].desc = '# Cambiar idioma';
                
                menuData[4].title = '~/tema';
                menuData[4].desc = '# Cambiar apariencia';
                menuData[4].children[0].title = '[☀] Claro';
                menuData[4].children[1].title = '[☾] Oscuro';

                menuData[5].title = '~/proyectos';
                menuData[5].desc = '# Explorar portfolio';
                
                menuData[5].children[0].children[0].title = '▪ Aplicación web para rastrear y analizar métricas de vida y hábitos diarios mediante visualizaciones de datos.';
                menuData[5].children[0].children[1].title = '↳ Ver app';
                menuData[5].children[0].children[2].title = '↳ Ver en GitHub';

                menuData[5].children[1].children[0].title = '▪ Repositorio centralizado de habilidades y agentes para asistentes IA. Facilita la programación y asegura la calidad del código.';
                menuData[5].children[1].children[1].title = '↳ Ver página de producto';
                menuData[5].children[1].children[2].title = '↳ Ver en GitHub';

                menuData[5].children[2].children[0].title = '▪ Plantilla moderna e interactiva para construir tu propio currículum o portafolio profesional. Fácil de configurar y desplegar.';
                menuData[5].children[2].children[1].title = '↳ Ver demo interactiva';
                menuData[5].children[2].children[2].title = '↳ Ver en GitHub';

                menuData[5].children[3].children[0].title = '▪ Aplicación web interactiva para visualizar y explorar mapas de identidad.';
                menuData[5].children[3].children[1].title = '↳ Ver app';
                menuData[5].children[3].children[2].title = '↳ Ver en GitHub';
            }

            renderMenu();
        };

        // Force translation on initial load to avoid race conditions with DOMContentLoaded
        if (typeof localStorage !== 'undefined') {
            const currentLang = localStorage.getItem('lang') || 'es';
            window.updateUIText(currentLang);
        }

        // Keyboard events
        window.addEventListener('keydown', (e) => {
            const menuVisible = !document.getElementById('console-menu')?.classList.contains('hidden');
            
            if (!menuVisible) {
                if (e.key === 'Escape') {
                    e.preventDefault();
                    location.reload();
                }
                return;
            }

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                let nextIdx = selectedIndex;
                while (nextIdx < flatList.length - 1) {
                    nextIdx++;
                    if (flatList[nextIdx].type !== 'text') {
                        selectedIndex = nextIdx;
                        break;
                    }
                }
                renderMenu(true);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                let prevIdx = selectedIndex;
                while (prevIdx > 0) {
                    prevIdx--;
                    if (flatList[prevIdx].type !== 'text') {
                        selectedIndex = prevIdx;
                        break;
                    }
                }
                renderMenu(true);
            } else if (e.key === 'Enter' || e.key === 'ArrowRight') {
                e.preventDefault();
                handleAction();
            } else if (e.key === 'Backspace') {
                if (searchQuery.length > 0) {
                    searchQuery = searchQuery.slice(0, -1);
                    selectedIndex = 0;
                    updateSearchIndicator();
                    renderMenu();
                } else {
                    e.preventDefault();
                    if (currentPath.length > 0) {
                        handleCollapse();
                    }
                }
            } else if (e.key === 'Escape') {
                e.preventDefault();
                if (searchQuery.length > 0) {
                    searchQuery = '';
                    selectedIndex = 0;
                    updateSearchIndicator();
                    renderMenu();
                } else {
                    location.reload();
                }
            } else if (e.key === 'ArrowLeft') {
                e.preventDefault();
                if (searchQuery.length > 0) {
                    searchQuery = '';
                    updateSearchIndicator();
                }
                if (currentPath.length > 0) {
                    handleCollapse();
                }
            } else if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
                // Ignore space bar if we're not searching, otherwise scrolling happens
                if (e.key === ' ' && searchQuery.length === 0) return;
                
                searchQuery += e.key;
                selectedIndex = 0;
                updateSearchIndicator();
                renderMenu();
            }
        });

        // Initialize App
        document.getElementById('menu-container')?.focus();
        
        // Hide global language button (terminal has its own)
        document.getElementById('global-actions')?.classList.add('hidden');
        document.body.classList.add('terminal-active');

        // Initial render
        renderMenu();
    </script>

    <style is:global>
        @keyframes menuSlide {
            from { opacity: 0; transform: translateY(-4px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .menu-item-anim {
            animation: menuSlide 0.2s ease-out forwards;
            opacity: 0;
        }

        @keyframes pulseFast {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }
        .animate-pulse-fast {
            animation: pulseFast 1s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        body.terminal-active {
            overflow: hidden;
        }
        body.terminal-active #global-logo,
        body.terminal-active #global-footer {
            display: none !important;
        }
        body.terminal-active #main-content {
            margin-top: 1rem !important;
            margin-bottom: 1rem !important;
            padding-top: 0 !important;
            padding-bottom: 0 !important;
            height: calc(100vh - 2rem);
            max-height: calc(100vh - 2rem);
        }
        @media (min-width: 640px) {
            body.terminal-active #main-content {
                margin-top: 2rem !important;
                margin-bottom: 2rem !important;
                height: calc(100vh - 4rem);
                max-height: calc(100vh - 4rem);
            }
        }
    </style>
</Layout>
