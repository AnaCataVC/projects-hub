---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
---

<Layout title="Ana-Catalina | Projects Hub">
    <div class="relative z-10 w-full flex-grow flex flex-col justify-center">
        <header class="text-left mb-16 max-w-2xl animate-fade-in">
            <h1 class="text-[3rem] sm:text-[4.5rem] font-bold m-0 mb-6 tracking-tight leading-[1.1]">
                Projects Hub<span class="bg-gradient-to-br from-purple-500 to-blue-500 bg-clip-text text-transparent">.</span>
            </h1>
            <p class="text-slate-500 dark:text-slate-400 text-sm sm:text-base font-light leading-relaxed max-w-xl m-0" data-i18n="subtitle_main">Proyectos personales desarrollados para explorar, aprender y compartir con la comunidad.</p>
        </header>
        
        <div class="flex flex-wrap justify-center gap-6 animate-fade-in delay-200">
            <div class="w-full md:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)] flex">
                <ProjectCard 
                    icon="analytics"
                demoHref="/life-tracker-analytics/"
                githubHref="https://github.com/AnaCataVC/life-tracker-analytics"
                badgeKey="badge_life"
                title="Life Tracker Analytics"
                descKey="desc_life"
                btnDemoKey="btn_view_app"
                btnGithubKey="btn_view_github"
                />
            </div>
            <div class="w-full md:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)] flex">
                <ProjectCard 
                    icon="ai"
                demoHref="/amiga-ia/"
                githubHref="https://github.com/AnaCataVC/amiga-ia"
                badgeKey="badge_amiga"
                title="Amiga IA"
                descKey="desc_amiga"
                btnDemoKey="btn_landing"
                btnGithubKey="btn_view_github"
                />
            </div>
            <div class="w-full md:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)] flex">
                <ProjectCard 
                    icon="cv"
                demoHref="/my-cv/"
                githubHref="https://github.com/AnaCataVC/my-cv"
                badgeKey="badge_cv"
                title="My CV Template"
                descKey="desc_cv"
                />
            </div>
            <!-- You can easily add more ProjectCard components here -->
        </div>

    </div>
</Layout>
