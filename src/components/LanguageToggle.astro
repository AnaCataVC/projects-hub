---
---

<div class="flex items-center bg-white/50 dark:bg-slate-800/50 rounded-full p-1 border border-slate-200/50 dark:border-slate-700/50 shadow-sm backdrop-blur-sm relative">
    <!-- Active Indicator Background -->
    <div id="lang-indicator" class="absolute top-1 bottom-1 left-1 bg-white dark:bg-slate-700 shadow-sm rounded-full transition-transform duration-300 ease-out w-[calc(50%-4px)] pointer-events-none"></div>
    
    <button id="lang-es" class="lang-btn relative z-10 w-10 sm:w-12 h-7 sm:h-8 rounded-full text-[11px] sm:text-xs font-medium transition-colors text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 flex items-center justify-center" data-lang="es">
        ES
    </button>
    <button id="lang-en" class="lang-btn relative z-10 w-10 sm:w-12 h-7 sm:h-8 rounded-full text-[11px] sm:text-xs font-medium transition-colors text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 flex items-center justify-center" data-lang="en">
        EN
    </button>
</div>

<script>
    type LangKeys = 'es' | 'en';

    const path = window.location.pathname;
    let pathLang: LangKeys | null = null;
    if (path !== '/' && path !== '') {
        const segments = path.split('/').filter(Boolean);
        pathLang = segments[0] === 'en' ? 'en' : 'es';
    }

    let currentLang = pathLang || (localStorage.getItem('lang') as LangKeys | null);
    
    if (!currentLang) {
        const browserLang = navigator.language || (navigator as any).userLanguage;
        currentLang = browserLang.toLowerCase().startsWith('es') ? 'es' : 'en';
    }
    localStorage.setItem('lang', currentLang); 

    const btnEs = document.getElementById('lang-es');
    const btnEn = document.getElementById('lang-en');
    const indicator = document.getElementById('lang-indicator');

    function setLanguage(lang: LangKeys) {
        if (currentLang !== lang) {
            const path = window.location.pathname;
            if (path !== '/' && path !== '') {
                const segments = path.split('/').filter(Boolean);
                const isEnRoute = segments[0] === 'en';
                
                if (lang === 'en' && !isEnRoute) {
                    localStorage.setItem('lang', lang);
                    window.location.href = `/en/${segments.join('/')}`;
                    return;
                } else if (lang === 'es' && isEnRoute) {
                    localStorage.setItem('lang', lang);
                    segments.shift();
                    window.location.href = `/${segments.join('/')}`;
                    return;
                }
            }
        }

        currentLang = lang;
        localStorage.setItem('lang', lang);
        
        if (lang === 'es') {
            (window as any).updateToggleUI(btnEs, btnEn, indicator, false);
        } else {
            (window as any).updateToggleUI(btnEn, btnEs, indicator, true);
        }
        if (typeof (window as any).updateUIText === 'function') {
            (window as any).updateUIText(lang);
        }
    }
    (window as any).setLanguageGlobal = setLanguage;

    if (btnEs && btnEn) {
        btnEs.addEventListener('click', () => setLanguage('es'));
        btnEn.addEventListener('click', () => setLanguage('en'));
        setLanguage(currentLang);
    }
</script>
