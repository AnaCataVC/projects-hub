---
interface Props {
    demoHref?: string;
    githubHref?: string;
    href?: string; // for backwards compatibility
    badgeKey: string;
    title: string;
    descKey: string;
    btnDemoKey?: string;
    btnGithubKey?: string;
    class?: string;
    icon?: 'analytics' | 'ai' | 'cv';
    imgSrc?: string;
}

const { demoHref, githubHref, href, badgeKey, title, descKey, btnDemoKey = "btn_demo", btnGithubKey = "btn_github", class: className = "", icon, imgSrc } = Astro.props;
const finalDemoHref = demoHref || href;

const defaultTranslations: Record<string, string> = {
    'badge_cv': 'Plantilla Open Source',
    'desc_cv': 'Una plantilla moderna e interactiva para crear tu propio currículum o portafolio profesional. Fácil de configurar y desplegar.',
    'badge_life': 'Aplicación Web',
    'desc_life': 'Una aplicación web para hacer seguimiento y analizar tus métricas de vida y hábitos diarios mediante visualizaciones de datos.',
    'badge_amiga': 'Herramienta de Código Abierto',
    'desc_amiga': 'Repositorio centralizado de skills y agentes para asistentes IA como Claude. Actúa como la fuente única de verdad de tu ecosistema.',
    'btn_demo': 'Ver demo',
    'btn_github': 'Fork en GitHub',
    'btn_view_github': 'Ver en GitHub',
    'btn_view_app': 'Ver app',
    'btn_landing': 'Página de producto'
};
---

<div class={`group relative flex flex-col bg-white/40 dark:bg-slate-800/40 backdrop-blur-xl border border-white/40 dark:border-slate-700/50 rounded-3xl p-6 lg:p-7 text-slate-800 dark:text-slate-100 no-underline transition-all duration-500 w-full box-border overflow-hidden hover:-translate-y-2 hover:border-white/60 dark:hover:border-slate-600/80 hover:shadow-2xl hover:shadow-purple-500/10 dark:hover:shadow-purple-500/10 ${className}`}>
    <!-- Glow effect behind the card on hover -->
    <div class="absolute -inset-[1px] bg-gradient-to-r from-purple-500 to-blue-500 rounded-3xl opacity-0 group-hover:opacity-20 transition-opacity duration-500 -z-10 blur-sm"></div>
    <!-- Glowing border effect on hover -->
    <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-purple-500 to-blue-500 opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
    
    <!-- Link overlay for the whole card -->
    {finalDemoHref && (
        <a href={finalDemoHref} class="absolute inset-0 z-10 rounded-3xl" aria-label={`Ir a ${title}`}>
            <span class="sr-only">View {title}</span>
        </a>
    )}
    

    <div class="flex flex-col flex-grow relative z-20 pointer-events-none">
        <div class="flex justify-between items-start mb-5">
            {(icon || imgSrc) && (
                <div class="flex items-center justify-center w-10 h-10 lg:w-11 lg:h-11 rounded-xl bg-gradient-to-br from-purple-500/10 to-blue-500/10 border border-purple-500/20 dark:from-purple-500/20 dark:to-blue-500/20 shadow-inner shadow-purple-500/10 group-hover:scale-110 transition-transform duration-500 overflow-hidden">
                    {imgSrc ? (
                        <img src={imgSrc} alt={`${title} icon`} class="w-full h-full object-cover" />
                    ) : (
                        <>
                            {icon === 'analytics' && (
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-purple-600 dark:text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="20" x2="18" y2="10"></line>
                                    <line x1="12" y1="20" x2="12" y2="4"></line>
                                    <line x1="6" y1="20" x2="6" y2="14"></line>
                                </svg>
                            )}
                            {icon === 'ai' && (
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-purple-600 dark:text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path>
                                </svg>
                            )}
                            {icon === 'cv' && (
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-purple-600 dark:text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                    <polyline points="10 9 9 9 8 9"></polyline>
                                </svg>
                            )}
                        </>
                    )}
                </div>
            )}
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold bg-white/60 dark:bg-slate-900/50 backdrop-blur-md border border-white/50 dark:border-slate-700/50 text-purple-600 dark:text-purple-400 w-fit uppercase tracking-wider shadow-sm transition-transform duration-300 group-hover:scale-105" data-i18n={badgeKey}>{defaultTranslations[badgeKey] || 'Etiqueta'}</span>
        </div>
        
        <h2 class="m-0 mb-3 text-xl lg:text-2xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-br from-slate-900 to-slate-600 dark:from-white dark:to-slate-400 group-hover:from-purple-600 group-hover:to-blue-500 dark:group-hover:from-purple-400 dark:group-hover:to-blue-400 transition-all duration-500">{title}</h2>
        
        <p class="text-slate-600 dark:text-slate-300 text-sm lg:text-base leading-relaxed flex-grow m-0 font-light" data-i18n={descKey}>{defaultTranslations[descKey] || 'Descripción'}</p>
        
        <div class="mt-6 flex flex-col w-full gap-3 text-xs lg:text-sm font-semibold pointer-events-auto">
            {finalDemoHref && (
                <a href={finalDemoHref} class="relative z-30 flex items-center justify-center w-full px-5 py-2.5 rounded-full bg-slate-900 dark:bg-white text-white dark:text-slate-900 group-hover:bg-purple-600 dark:group-hover:bg-purple-500 group-hover:text-white dark:group-hover:text-white hover:bg-purple-500 dark:hover:bg-purple-400 transition-all duration-300 shadow-md group-hover:shadow-lg group-hover:shadow-purple-500/30 no-underline">
                    <span data-i18n={btnDemoKey}>{defaultTranslations[btnDemoKey] || 'Ver'}</span>
                    <span class="ml-1.5 transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
                </a>
            )}
            {githubHref && (
                <a href={githubHref} target="_blank" rel="noopener noreferrer" class="relative z-30 flex items-center justify-center w-full px-5 py-2.5 rounded-full bg-white/50 dark:bg-slate-800/50 backdrop-blur-md border border-slate-200 dark:border-slate-700 transition-all duration-300 text-slate-700 dark:text-slate-200 hover:border-purple-500/50 dark:hover:border-purple-400/50 hover:text-purple-600 dark:hover:text-purple-400 hover:bg-white/80 dark:hover:bg-slate-800/80 no-underline group/link">
                    <svg class="w-4 h-4 mr-1.5 fill-current transition-colors duration-300" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                    <span data-i18n={btnGithubKey}>{defaultTranslations[btnGithubKey] || 'GitHub'}</span>
                </a>
            )}
        </div>
    </div>
</div>
